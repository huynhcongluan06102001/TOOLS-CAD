;;; ===== tc-geometry =====
;;; Pure planar geometry, millimetres / WCS. No AutoCAD database calls here.
(defun tc:v+ (a b) (mapcar '+ a b))
(defun tc:v- (a b) (mapcar '- a b))
(defun tc:v* (a s) (mapcar '(lambda (x) (* x s)) a))
(defun tc:dot (a b) (apply '+ (mapcar '* a b)))
(defun tc:len (a) (sqrt (tc:dot a a)))
(defun tc:dist (a b) (tc:len (tc:v- a b)))
(defun tc:unit (a / n) (setq n (tc:len a)) (if (> n 0.000000001) (tc:v* a (/ 1.0 n))))
(defun tc:perp (a) (list (- (cadr a)) (car a) 0.0))
(defun tc:angle (a b / v) (setq v (tc:v- b a)) (atan (cadr v) (car v)))
(defun tc:polar (a ang len) (tc:v+ a (list (* len (cos ang)) (* len (sin ang)) 0.0)))
(defun tc:wrap (a)
  (while (> a pi) (setq a (- a (* 2.0 pi))))
  (while (<= a (- pi)) (setq a (+ a (* 2.0 pi)))) a)
(defun tc:turn (a b c) (tc:wrap (- (tc:angle b c) (tc:angle a b))))
(defun tc:elbow-rotation (a b c / d ang)
  ;; Same native elbow orientation as VEONGPPR/VEMANGCAP VBA.
  (setq d (tc:turn a b c) ang (tc:angle a b))
  (+ ang (if (> d 0.0) (abs d) pi)))
(defun tc:corner (a b c / d)
  (setq d (abs (* 180.0 (/ (tc:turn a b c) pi))))
  (cond ((< d 0.01) 0) ((< (abs (- d 45.0)) 0.1) 45)
        ((< (abs (- d 90.0)) 0.1) 90) (T nil)))
(defun tc:project (p a b clamp / v den u)
  (setq v (tc:v- b a) den (tc:dot v v))
  (if (< den 0.000000000001) a
    (progn (setq u (/ (tc:dot (tc:v- p a) v) (float den)))
      (if clamp (setq u (max 0.0 (min 1.0 u)))) (tc:v+ a (tc:v* v u)))))
(defun tc:on-segment (p a b tol) (<= (tc:dist p (tc:project p a b T)) tol))
(defun tc:intersection (a b c d / v w den s u)
  ;; Infinite 2D line intersection. Caller checks segment/gap limits.
  (setq v (tc:v- b a) w (tc:v- d c)
        den (- (* (car v) (cadr w)) (* (cadr v) (car w))))
  (if (> (abs den) 0.0000000001)
    (progn (setq s (tc:v- c a)
      u (/ (- (* (car s) (cadr w)) (* (cadr s) (car w))) (float den)))
      (tc:v+ a (tc:v* v u)))))
(defun tc:line-angle (a b c d / ang)
  (setq ang (abs (tc:wrap (- (tc:angle a b) (tc:angle c d)))))
  (if (> ang (/ pi 2.0)) (- pi ang) ang))
(defun tc:near-end (p a b) (if (< (tc:dist p a) (tc:dist p b)) a b))
(defun tc:far-end (p a b) (if (> (tc:dist p a) (tc:dist p b)) a b))
(defun tc:dedup (pts / out p)
  (foreach p pts (if (or (null out) (> (tc:dist p (car out)) 0.0000001)) (setq out (cons p out))))
  (reverse out))
(defun tc:simplify (pts / out p)
  (foreach p (tc:dedup pts)
    (while (and (cadr out) (equal (tc:corner (cadr out) (car out) p) 0))
      (setq out (cdr out))) (setq out (cons p out))) (reverse out))
(defun tc:chunks (flat n / out item)
  (while flat (setq item nil)
    (repeat n (setq item (cons (car flat) item) flat (cdr flat)))
    (setq out (cons (reverse item) out))) (reverse out))
(defun tc:replace-nth (n val xs / i)
  (setq i -1) (mapcar '(lambda (x) (setq i (1+ i)) (if (= i n) val x)) xs))
(defun tc:sort (items compare)
  ;; vl-sort can remove equal items; sorting indices preserves every selected item.
  (mapcar '(lambda (i) (nth i items)) (vl-sort-i items compare)))
(defun tc:nearest-order (pts start / out best p)
  ;; Remove exactly one occurrence; duplicate insertion points are preserved.
  (setq out (list start))
  (while pts
    (setq best (car pts))
    (foreach p (cdr pts) (if (< (tc:dist start p) (tc:dist start best)) (setq best p)))
    (setq pts (tc:remove-one best pts) out (cons best out) start best)) (reverse out))
(defun tc:remove-one (item xs)
  (cond ((null xs) nil) ((equal item (car xs)) (cdr xs))
        (T (cons (car xs) (tc:remove-one item (cdr xs))))))
(defun tc:row-order (pts tol / rows row p found result rev anchor)
  ;; Group by a fixed row anchor, avoiding a non-transitive sort comparator.
  (setq pts (tc:sort pts '(lambda (a b) (if (equal (cadr a) (cadr b) 0.00000001)
                             (< (car a) (car b)) (> (cadr a) (cadr b))))))
  (foreach p pts
    (if (and row (<= (abs (- (cadr p) anchor)) tol))
      (setq row (cons p row))
      (progn (if row (setq rows (cons row rows))) (setq row (list p) anchor (cadr p)))))
  (if row (setq rows (cons row rows)))
  (foreach row (reverse rows)
    (setq row (tc:sort row '(lambda (a b) (< (car a) (car b)))))
    (if rev (setq row (reverse row)))
    (setq result (append result row) rev (not rev))) result)
(defun tc:ortho-route (pts / out a b)
  (if pts (progn (setq a (car pts) out (list a))
    (foreach b (cdr pts)
      (setq out (append out (list (list (car b) (cadr a) (caddr a)) b)) a b))))
  (tc:dedup out))
(defun tc:grid (a b cols rows / dx dy x y i j pts)
  ;; Centred cell spacing; single row/column stays at centre.
  (setq dx (/ (abs (- (car b) (car a))) (float cols))
        dy (/ (abs (- (cadr b) (cadr a))) (float rows)) i 0)
  (repeat rows (setq j 0)
    (repeat cols (setq pts (cons (list (+ (min (car a) (car b)) (* (+ j 0.5) dx))
                       (+ (min (cadr a) (cadr b)) (* (+ i 0.5) dy)) (caddr a)) pts) j (1+ j)))
    (setq i (1+ i))) (reverse pts))
(defun tc:intervals (intervals lo hi / sorted out a b iv)
  ;; Union and clamp cut intervals to the original segment.
  (setq sorted (tc:sort intervals '(lambda (x y) (< (car x) (car y)))))
  (foreach iv sorted
    (setq a (max lo (car iv)) b (min hi (cadr iv)))
    (if (> b a)
      (if (and out (<= a (+ (cadar out) 0.0000001)))
        (setq out (cons (list (caar out) (max b (cadar out))) (cdr out)))
        (setq out (cons (list a b) out))))) (reverse out))
(defun tc:complement (intervals lo hi / out iv cursor)
  (setq cursor lo)
  (foreach iv (tc:intervals intervals lo hi)
    (if (> (- (car iv) cursor) 0.000001) (setq out (cons (list cursor (car iv)) out)))
    (setq cursor (cadr iv)))
  (if (> (- hi cursor) 0.000001) (setq out (cons (list cursor hi) out))) (reverse out))
(defun tc:steel-d (dn) (cdr (assoc (fix dn) '((15 . 21.0) (20 . 27.0) (25 . 34.0)
  (32 . 42.0) (40 . 49.0) (50 . 60.0) (65 . 76.0) (80 . 90.0)
  (100 . 114.0) (125 . 141.0) (150 . 168.0)))))
(defun tc:dn-values (system)
  (cond ((= system "PPR") '(20 25 32 40 50 63 75 90 110 125))
        ((= system "UPVC") '(21 27 34 42 49 60 75 90 114 140 168 220 280))
        (T '(15 20 25 32 40 50 65 80 100 125 150))))
(defun tc:steel-dn (diam / found pair)
  (foreach pair '((15 . 21.0) (20 . 27.0) (25 . 34.0) (32 . 42.0) (40 . 49.0)
      (50 . 60.0) (65 . 76.0) (80 . 90.0) (100 . 114.0) (125 . 141.0) (150 . 168.0))
    (if (< (abs (- diam (cdr pair))) 0.1) (setq found (car pair)))) found)
(defun tc:steel-prefix (dn / selected)
  (setq selected (tc:cfg 'steeljoint))
  (cond ((= selected "SCREW") "SCREW-") ((= selected "WELD") "WELD-")
    (T (if (< dn 60) "SCREW-" "WELD-"))))
(defun tc:elbow-name (system material dn degrees / d prefix suffix)
  (setq d (rtos dn 2 0))
  (cond ((= system "TRAY") (strcat "Elbow " (if (= degrees 45) "45 " "") material))
        ((= system "DUCT") (strcat "Co " (if (= (strcase material) "TRON") "tron " "")
          (itoa degrees) (cond ((wcmatch (strcase material) "*TIEU AM*") " tieu am")
                             ((wcmatch (strcase material) "*CACH NHIET*") " cach nhiet") (T ""))))
        ((= system "STEEL") (strcat (tc:steel-prefix dn) "ELB"
          (itoa degrees) "-DN" d))
        (T (strcat "ELB" (itoa degrees) "-D" d (if (= system "PPR") (strcat " " material) "")))))
(defun tc:branch-name (system material kind d1 d2 / stem)
  (setq stem (strcat (if (= system "STEEL") (tc:steel-prefix d1) "")
    kind (if (= system "STEEL") "-DN" "-D") (rtos d1 2 0) "x" (rtos d2 2 0)))
  (if (= system "PPR") (strcat stem " " material) stem))
(defun tc:trunk-fitting-name (system material kind / suffix)
  (if (= system "TRAY")
    (cond ((= kind "RED") (strcat "Reducer " material))
          ((= kind "TEE") (strcat "Tee " material))
          ((= kind "CROSS") (strcat "Cross " material)))
    (progn (setq suffix (cond ((wcmatch (strcase material) "*TIEU AM*") " tieu am")
      ((wcmatch (strcase material) "*CACH NHIET*") " cach nhiet") (T "")))
      (cond ((= kind "RED") (if (= (strcase material) "TRON") "Con tron giam" (strcat "Con giam deu" suffix)))
            ((= kind "TEE") (if (= (strcase material) "TRON") "Chac chu T" (strcat "Chac 3" suffix)))
            ((and (= kind "SHOE") (/= (strcase material) "TRON")) (strcat "Chac chu T cong" suffix))
            ((and (= kind "Y") (= suffix "") (/= (strcase material) "TRON")) "Chac chu Y")))))
(defun tc:canonical-material (system material / upper)
  (setq upper (strcase (vl-string-trim " " material)))
  (if (and (= system "DUCT") (wcmatch upper "ONG GIO *")) (setq upper (substr upper 9)))
  (cond
    ((= system "TRAY") (cond ((= upper "CABLE TRAY") "Cable tray") ((= upper "TRUNKING") "Trunking") ((= upper "LADDER") "Ladder")))
    ((= system "DUCT") (cond ((= upper "NEP TDC") "nep TDC") ((= upper "NEP C") "nep C") ((= upper "TRON") "tron")
      ((= upper "TIEU AM NEP TDC") "tieu am nep TDC") ((= upper "CACH NHIET NEP TDC") "cach nhiet nep TDC")
      ((= upper "CACH NHIET NEP C") "cach nhiet nep C")))
    ((= system "PPR") (if (= upper "HDPE") "HDPE" "PPR"))
    ((= system "UPVC") (if (= upper "UPVC_M") "UPVC_m" "UPVC")) ((= system "STEEL") "STK")))
(defun tc:fitting-name (system material kind dn dn2 / suffix direction degrees n n2)
  (setq n (rtos dn 2 0) n2 (rtos dn2 2 0))
  (cond
    ((= (substr kind 1 6) "BLOCK|") (substr kind 7))
    ((= kind "RISER") (tc:branch-name system material "Y" dn dn2))
    ((= kind "YUP") (tc:branch-name system material "Y" dn dn2))
    ((= kind "MALE") (strcat "AD-MALE-D" n (if (= system "PPR") (strcat " " material) "")))
    ((= kind "FEMALE") (strcat "AD-FEMALE-D" n (if (= system "PPR") (strcat " " material) "")))
    ((= kind "VALVE_UPVC") (strcat "Valve uPVC D" n))
    ((= kind "CLEANOUT") (strcat "thong tac D" n))
    ((= kind "TRAP") (strcat "Tho D" n))
    ((= kind "TRAP_SA") (strcat "SA-D" n "x" n2))
    ((= kind "FLANGE") (strcat "FLANGE - uPVC D" n))
    ((= kind "VALVE") (strcat "VALVE-D" n " " material))
    ((= kind "VALVE_FEMALE") (strcat "VALVE-FEMALE-D" n " " material))
    ((= kind "UNION") (strcat "U-D" n " " material))
    ((= kind "WATER_METER") (strcat "WATER-METER-D" n))
    ((= kind "CAP") (if (= system "STEEL") (strcat (tc:steel-prefix dn) "CAP-DN" n) (strcat "CAP-D" n " " material)))
    ((= kind "BALL") (strcat "Valve Ball DN" n))
    ((= kind "GATE") (strcat "Van cong - DN" n (if (and (< dn 50) (/= dn 15)) " - ren" "")))
    ((= kind "BUTTERFLY") (strcat "Van buom tay gat - DN" n))
    ((= kind "YFILTER") (strcat "Y Loc - DN" n))
    ((= kind "CHECKVALVE") (strcat "Van 1 chieu - DN" n (if (< dn 50) " - ren" "")))
    ((= kind "FLAP") (strcat "Van mot chieu la lat - DN" n))
    ((= kind "FLEX") (strcat "Khop noi mem - DN" n))
    ((= kind "UNION_MF") (strcat "Rac co ren ngoai - ren trong DN" n))
    ((= kind "UNION_FF") (strcat "Rac co ren trong DN" n))
    ((= kind "NIPPLE") (strcat "Kep ren DN" n))
    ((= kind "BUSH") (strcat "Ca ra DN" n "x" n2))
    ((= kind "ELB90") (tc:elbow-name system material dn 90))
    ((= kind "ELB45") (tc:elbow-name system material dn 45))
    ((member kind '("TEE" "RED" "Y" "CROSS" "SHOE"))
      (if (member system '("PPR" "UPVC" "STEEL"))
        (if (not (member kind '("CROSS" "SHOE"))) (tc:branch-name system material kind dn dn2))
        (tc:trunk-fitting-name system material kind)))
    ((member kind '("UP90" "DOWN90" "UP45" "DOWN45"))
      (setq degrees (if (wcmatch kind "*45") 45 90) direction (if (wcmatch kind "UP*") "up" "down"))
      (cond
        ((= system "TRAY") (if (= degrees 90) (strcat "Elbow " direction " " material)))
        ((= system "DUCT")
          (setq suffix (cond ((wcmatch (strcase material) "*TIEU AM*") " tieu am")
            ((wcmatch (strcase material) "*CACH NHIET*") " cach nhiet") (T "")))
          (strcat "Co " (if (= (strcase material) "TRON") "tron " "") direction " " (itoa degrees) suffix))
        (T (tc:elbow-name system material dn degrees))))))
(defun tc:terminal-p (a b cp tolerance / length position)
  ;; Gap permits extension beyond an endpoint; it must not classify an interior tee as an elbow.
  (setq length (tc:dist a b) position (tc:dot (tc:v- cp a) (tc:unit (tc:v- b a))))
  (or (<= position tolerance) (>= position (- length tolerance))))
(defun tc:arrow-points (tip direction size)
  (list (tc:polar tip (+ direction pi (/ pi 6.0)) size) tip (tc:polar tip (- (+ direction pi) (/ pi 6.0)) size)))
(defun tc:fitting-width-values (system name main branch first second)
  (if (and (= system "DUCT") (wcmatch (strcase name) "CHAC 3*"))
    (list (list "Width2" main) (list "Width1" branch))
    (append (list (list first main)) (if second (list (list second branch))))))
(princ)

