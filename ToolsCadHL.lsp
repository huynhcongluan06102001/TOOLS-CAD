;;; ===== tc-palette =====
;;; Modeless .NET PaletteSet bridge. Compiled DLL bytes are embedded in the release LSP.
(defun tc:mkdirs (folder / parent)
  (if (not (vl-file-directory-p folder))
    (progn
      (setq parent (vl-filename-directory folder))
      (if (and parent (/= parent folder)) (tc:mkdirs parent))
      (if (not (vl-mkdir folder)) (tc:fail (strcat "Khong tao duoc thu muc: " folder))))) folder)
(defun tc:extract-palette ( / root path dom element stream result encoded chunk)
  (setq root (getenv "APPDATA")) (if (null root) (setq root (getvar "TEMPPREFIX")))
  (setq root (strcat (vl-string-right-trim "\\/" root) "/ToolsCadHL/2024/" *tc-palette-hash*))
  (tc:mkdirs root) (setq path (strcat root "/ToolsCadPalette.dll"))
  (setq result (vl-catch-all-apply '(lambda ()
    (setq dom (vlax-create-object "MSXML2.DOMDocument.6.0")
      element (vlax-invoke-method dom 'createElement "binary"))
    (vlax-put-property element 'dataType "bin.base64")
    (setq encoded "") (foreach chunk *tc-palette-bytes* (setq encoded (strcat encoded chunk)))
    (vlax-put-property element 'text encoded)
    (setq stream (vlax-create-object "ADODB.Stream"))
    (vlax-put-property stream 'Type 1) (vlax-invoke-method stream 'Open)
    (vlax-invoke-method stream 'Write (vlax-get-property element 'nodeTypedValue))
    (vlax-invoke-method stream 'SaveToFile path 2)
    (vlax-invoke-method stream 'Close)) nil))
  (foreach *tc-com-item* (list stream element dom)
    (if (and *tc-com-item* (not (vlax-object-released-p *tc-com-item*))) (vlax-release-object *tc-com-item*)))
  (if (vl-catch-all-error-p result) (tc:fail (strcat "Khong giai nen giao dien: " (vl-catch-all-error-message result)))) path)
(defun tc:show-palette ( / result path *error*)
  (defun *error* (msg) (princ (strcat "\nTools Cad HL: " msg " | TCDCL mo giao dien DCL du phong.")) (princ))
  (setq result (vl-catch-all-apply 'TC_PALETTE_SHOW_010 nil))
  (if (vl-catch-all-error-p result)
    (progn
      (if (not (boundp '*tc-palette-bytes*)) (tc:fail "Ban LSP nay chua nhung giao dien PaletteSet."))
      (setq path (tc:extract-palette))
      ;; Leave AutoCAD's trusted-path/security confirmation intact.
      (command-s "_NETLOAD" path)
      (setq result (vl-catch-all-apply 'TC_PALETTE_SHOW_010 nil))
      (if (vl-catch-all-error-p result)
        (princ (strcat "\nKhong nap duoc PaletteSet. Kiem tra NETLOAD va quyen nap DLL: " path
          "\nCan AutoCAD 2024 Windows ban day du. TCDCL mo giao dien du phong."))))) (princ))
(defun tc:apply-palette-settings (pairs / entry found value)
  (foreach entry *tc-defaults*
    (setq found (assoc (strcase (vl-symbol-name (car entry)) T) pairs))
    (if found
      (progn
        (setq value (cadr found))
        (if (not (eq (type value) (type (cdr entry)))) (tc:fail "Du lieu giao dien khong dung kieu."))
        (tc:set (car entry) value))))
  (if (not (member (tc:cfg 'system) '("PPR" "UPVC" "STEEL" "TRAY" "DUCT"))) (tc:fail "He thong khong hop le."))
  (if (not (snvalid (tc:cfg 'layer))) (tc:fail "Ten layer khong hop le.")) (tc:save-config))
(defun tc:palette-live ( / result entry value)
  (if *tc-palette-input*
    (progn
      (setq result (vl-catch-all-apply 'TC_PALETTE_LIVE_010 nil))
      (if (and (not (vl-catch-all-error-p result)) (eq (type result) 'STR) (> (strlen result) 0)) (setq result (read result)))
      (if (and (not (vl-catch-all-error-p result)) (eq (type result) 'LIST))
        (foreach entry '(dn width height)
          (setq value (cadr (assoc (strcase (vl-symbol-name entry) T) result)))
          (if (and (numberp value) (> value 0.0)) (tc:set entry value)))))))
(defun tc:palette-dispatch (request / action command system)
  (tc:apply-palette-settings (cadr (assoc "settings" request)))
  (setq action (cadr (assoc "action" request)) command (cadr (assoc "command" request)) system (tc:cfg 'system))
  (cond
    ((= action "DRAW") (tc:draw system))
    ((= action "AUTOFIT") (tc:autofit system))
    ((= action "FITTING") (tc:palette-fitting))
    ((= action "STATS") (tc:statistics system nil))
    ((= action "COMMAND")
      (if (not (vl-some '(lambda (item) (= (cadr item) command)) *tc-commands*)) (tc:fail "Lenh khong nam trong danh sach."))
      ;; Reuse the function body, avoiding nested command undo groups.
      (tc:palette-command command))
    (T (tc:fail "Thao tac giao dien khong hop le."))))
(defun c:TC_EXEC ( / token request *tc-palette-input*)
  (setq token (getstring "\nMa yeu cau: ") request (vl-catch-all-apply 'TC_PALETTE_TAKE_010 (list token)))
  (if (and (not (vl-catch-all-error-p request)) (eq (type request) 'STR) (> (strlen request) 0))
    (progn
      (setq request (read request))
      (setq *tc-palette-input* T)
      (tc:run '(lambda () (tc:palette-dispatch request)))
      (vl-catch-all-apply 'TC_PALETTE_DONE_010 (list token *tc-last-message* (if *tc-last-ok* "1" "0"))))) (princ))
(defun c:TCDCL () (tc:panel))
(princ)

