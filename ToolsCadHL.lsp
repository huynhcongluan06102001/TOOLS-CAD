(defun tc:initialize ( / names)
  (setq names (tc:block-names (tc:dbx)))
  (tc:mline-style)
  (princ (strcat "\nThu vien: " (tc:library-path) "\n" (itoa (length names))
    " block co ten. Nhap tung block khi can; khong chen nguyen ban ve mau.")))
(defun tc:diagnostics ( / path item missing)
  (princ (strcat "\nTools Cad HL " *tc-version* " | AutoCAD " (getvar "ACADVER")
    " | platform=" (getvar "PLATFORM") " | LISPSYS=" (itoa (getvar "LISPSYS"))))
  (princ "\nHo tro AutoCAD Windows ban day du; chua ho tro AutoCAD LT/macOS.")
  (setq path (tc:library-path))
  (if path (princ (strcat "\nTemplate: " path)) (princ "\nChua chon template. Go TCTEMPLATE."))
  (princ (strcat "\nModel space=" (if (> (getvar "CVPORT") 1) "OK" "CAN CHUYEN SANG MODEL")
    " | Don vi ve/met=" (rtos (tc:cfg 'unit) 2 3)))
  (princ "\nDung TCINIT de kiem tra ObjectDBX; TCSELFTEST de chay thu tren ban ve moi."))
(defun tc:assert (condition message)
  (if condition (progn (setq *tc-test-count* (1+ *tc-test-count*))
    (princ (strcat "\nPASS " (itoa *tc-test-count*) ": " message)))
    (tc:fail (strcat "SELFTEST FAIL: " message))))
(defun tc:selftest-body ( / sys y pts obj seg test cases case result fit main branch plan)
  (setq *tc-test-count* 0)
  (tc:assert (= (tc:corner '(0.0 0.0 0.0) '(1000.0 0.0 0.0) '(1000.0 1000.0 0.0)) 90) "Nhan dien co 90")
  (tc:assert (null (tc:corner '(0.0 0.0 0.0) '(1000.0 0.0 0.0) '(1200.0 1000.0 0.0))) "Tu choi goc khong ho tro")
  (tc:set 'note "0") (tc:set 'layer "TC_SELFTEST") (tc:set 'width 200.0) (tc:set 'height 100.0)
  (tc:layer "TC_SELFTEST" 4)
  (setq cases '(("PPR" "PPR" 25.0) ("UPVC" "UPVC" 60.0) ("STEEL" "STK" 25.0)
    ("TRAY" "Cable tray" 0.0) ("DUCT" "nep TDC" 0.0) ("DUCT" "tron" 0.0)) y 0.0)
  (foreach case cases
    (setq sys (car case)) (tc:set 'system sys) (tc:set 'material (cadr case)) (tc:set 'dn (caddr case))
    (setq pts (list (list 0.0 y 0.0) (list 4000.0 y 0.0) (list 4000.0 (+ y 4000.0) 0.0)
                   (list 8000.0 (+ y 8000.0) 0.0)))
    (tc:build-sized-route pts (list (list (caddr case) 200.0 100.0) (list (caddr case) 200.0 100.0)
      (list (caddr case) 200.0 100.0)) sys)
    (tc:assert T (strcat "Tao tuyen + cong noi hinh hoc " sys " / " (cadr case)))
    (setq y (+ y 12000.0)))
  (tc:set 'system "PPR") (tc:set 'material "PPR")
  (tc:build-sized-route '((12000.0 5000.0 0.0) (16000.0 5000.0 0.0) (20000.0 5000.0 0.0) (20000.0 9000.0 0.0))
    '((32.0 200.0 100.0) (25.0 200.0 100.0) (25.0 200.0 100.0)) "PPR")
  (tc:assert T "Doi Size PPR 32 -> 25 va noi co 90")
  (setq obj (tc:straight '(12000.0 0.0 0.0) '(17000.0 0.0 0.0) "PPR" "PPR" 25.0 0.0 0.0 "TC_SELFTEST"))
  (tc:assert (equal (tc:entity-length obj) 5000.0 0.000001) "Thong ke MLINE 5000 mm")
  (tc:assert (= (tc:xget obj "TC_SYSTEM") "PPR") "Doc/ghi XData")
  (setq obj (tc:straight '(12000.0 1000.0 0.0) '(17000.0 1000.0 0.0) "TRAY" "Cable tray" 0.0 300.0 100.0 "TC_SELFTEST"))
  (tc:assert (equal (tc:dyn obj "Length") 5000.0 0.000001) "Ghi dynamic Length")
  (tc:assert (equal (tc:dyn obj "Width1") 300.0 0.000001) "Ghi dynamic Width1")
  (tc:assert (equal (tc:entity-length obj) 5000.0 0.000001) "Doc chieu dai block dong")
  (tc:assert (= (cdr (assoc "CABLETRAY" (tc:attributes obj))) "W300xH100") "Gan thuoc tinh SIZE theo tag thuc te")
  (setq obj (tc:aligned-dim '(12000.0 0.0 0.0) '(17000.0 0.0 0.0) '(12000.0 -1000.0 0.0) "TC_SELFTEST"))
  (tc:assert (equal (vla-get-Measurement obj) 5000.0 0.000001) "Tao DIM do duoc 5000 mm")
  (tc:set 'gap 150.0) (tc:set 'endpoint-tol 1.0) (tc:set 'fit-flip "0")
  (setq cases '(("DUCT" "nep TDC" "SHOE" 0.0 400.0 200.0)
    ("DUCT" "nep TDC" "TEE" 0.0 400.0 200.0)
    ("DUCT" "tron" "TEE" 0.0 400.0 200.0)
    ("UPVC" "UPVC" "TEE" 60.0 60.0 49.0)) y 0.0)
  (foreach case cases
    (setq sys (nth 0 case)) (tc:set 'system sys) (tc:set 'material (nth 1 case)) (tc:set 'duct-branch (nth 2 case))
    (setq main (tc:straight (list 28000.0 y 0.0) (list 34000.0 y 0.0) sys (nth 1 case)
      (nth 3 case) (nth 4 case) 100.0 "TC_SELFTEST")
      branch (tc:straight (list 31000.0 y 0.0) (list 31000.0 (+ y 3000.0) 0.0) sys (nth 1 case)
      (if (= sys "UPVC") 49.0 0.0) (nth 5 case) 100.0 "TC_SELFTEST")
      plan (tc:fit-pair (tc:segment main sys) (tc:segment branch sys)) fit (car plan))
    (tc:assert (= (tc:xget fit "TC_FITTING") "1") (strcat "Chen nhanh " sys " / " (nth 1 case) " / " (nth 2 case)))
    (if (= sys "DUCT")
      (tc:assert (if (= (nth 2 case) "SHOE")
        (and (equal (tc:dyn fit "Width1") 400.0 0.01) (equal (tc:dyn fit "Width2") 200.0 0.01))
        (if (= (nth 1 case) "tron")
          (and (equal (tc:dyn fit "Diameter1") 400.0 0.01) (equal (tc:dyn fit "Diameter2") 200.0 0.01))
          (and (equal (tc:dyn fit "Width2") 400.0 0.01) (equal (tc:dyn fit "Width1") 200.0 0.01)))) "Kich thuoc main/nhanh dung tham so template")
      (tc:assert (= (strcase (tc:name fit)) "TEE-D60X49") "Tee UPVC dung hai duong kinh"))
    (tc:trim-segments (list plan))
    (setq y (+ y 6000.0)))
  (princ (strcat "\nSELFTEST PASS: " (itoa *tc-test-count*) " checks. Kiem tra truc quan cac tuyen vua tao.")))
(defun tc:selftest ( / saved result)
  (if (or (/= (vla-get-Count (tc:space)) 0) (/= (getvar "DBMOD") 0))
    (tc:fail "TCSELFTEST chi chay trong ban ve Model rong, chua sua. Mo NEW truoc."))
  (setq saved *tc-settings* result (vl-catch-all-apply 'tc:selftest-body nil) *tc-settings* saved)
  (if (vl-catch-all-error-p result)
    (tc:fail (if *tc-failure* *tc-failure* (vl-catch-all-error-message result)))))
(princ)

