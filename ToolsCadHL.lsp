;;; Runtime, configuration, COM helpers and command transaction boundary.
(vl-load-com)
(setq *tc-version* "0.10.0")
(setq *tc-defaults* '((system . "PPR") (material . "PPR") (dn . 25.0) (width . 200.0)
  (height . 100.0) (layer . "TC_PPR") (service . "CW") (elevation . "0")
  (text . 100.0) (overlap . 20.0) (gap . 150.0) (rowtol . 100.0)
  (fillet . 100.0) (drop . 300.0) (allowance . 0.0) (scale . 1.0)
  (unit . 1000.0) (erase . "0") (note . "1") (steeljoint . "AUTO")
  (dn2 . 20.0) (fit-dn . 25.0) (fit-width . 300.0) (fit-width2 . 200.0) (fit-height . 100.0)
  (fit-kind . "ELB90") (fit-flip . "0") (fit-mode . "Batch") (source . "Pick")
  (endpoint-tol . 1.0) (auto-connect . "1") (duct-branch . "SHOE") (note-prefix . "") (note-suffix . "")
  (fit-state . "") (trim . "1")))
(if (not (boundp '*tc-settings*)) (setq *tc-settings* *tc-defaults*))
(foreach *tc-default-entry* *tc-defaults*
  (if (not (assoc (car *tc-default-entry*) *tc-settings*)) (setq *tc-settings* (append *tc-settings* (list *tc-default-entry*)))))
(defun tc:cfg (key) (cdr (assoc key *tc-settings*)))
(defun tc:set (key value / pair)
  (if (setq pair (assoc key *tc-settings*))
    (setq *tc-settings* (subst (cons key value) pair *tc-settings*))))
(defun tc:save-config () (setenv "TOOLS_CAD_SETTINGS" (vl-prin1-to-string *tc-settings*)))
(defun tc:read-config ( / text data pair default)
  (if (setq text (getenv "TOOLS_CAD_SETTINGS"))
    (progn (setq data (vl-catch-all-apply 'read (list text)))
      (if (and (not (vl-catch-all-error-p data)) (eq (type data) 'LIST))
        (foreach default *tc-defaults*
          (setq pair (assoc (car default) data))
          (if (and pair (eq (type (cdr default)) (type (cdr pair)))
                   (or (not (eq (type (cdr pair)) 'REAL)) (> (cdr pair) 0.0)
                       (member (car pair) '(allowance overlap))))
            (tc:set (car pair) (cdr pair))))))))
(defun tc:doc () (vla-get-ActiveDocument (vlax-get-acad-object)))
(defun tc:space () (vla-get-ModelSpace (tc:doc)))
(defun tc:obj (e) (vlax-ename->vla-object e))
(defun tc:ename (o) (vlax-vla-object->ename o))
(defun tc:variant-list (x / result)
  (cond ((eq (type x) 'VARIANT) (tc:variant-list (vlax-variant-value x)))
        ((eq (type x) 'SAFEARRAY)
          (setq result (vl-catch-all-apply 'vlax-safearray->list (list x)))
          (if (vl-catch-all-error-p result) nil result)) (T x)))
(defun tc:array (xs kind / arr)
  (setq arr (vlax-make-safearray kind (cons 0 (1- (length xs)))))
  (vlax-safearray-fill arr xs) arr)
(defun tc:3d (p) (vlax-3d-point p))
(defun tc:touch () (setq *tc-dirty* T))
(defun tc:new (o) (tc:touch) o)
(defun tc:delete (o) (vla-delete o) (tc:touch))
(defun tc:fail (message) (setq *tc-failure* message) (exit))
(defun tc:model-check ()
  (if (= (getvar "CVPORT") 1) (tc:fail "Hay chuyen sang Model space truoc khi chay lenh.")))
(defun tc:point (message / p)
  (if (setq p (getpoint message)) (tc:xy-check (trans p 1 0))))
(defun tc:next-point (base message / p)
  (if (setq p (getpoint (trans base 0 1) message)) (tc:xy-check (trans p 1 0))))
(defun tc:xy-check (p)
  (if (> (abs (caddr p)) 0.000001) (tc:fail "Chi ho tro mat phang WCS XY, cao do hinh hoc Z=0.")) p)
(defun tc:positive (message value / x)
  (initget 6) (if (setq x (getreal (strcat message " <" (rtos value 2 2) ">: "))) x value))
(defun tc:integer (message value / x)
  (initget 6) (if (setq x (getint (strcat message " <" (itoa value) ">: "))) x value))
(defun tc:choose (message choices default / x)
  (initget choices) (if (setq x (getkword (strcat message " <" default ">: "))) x default))
(defun tc:selection (filter / ss i result)
  (prompt "\nChon doi tuong: ")
  (if (setq ss (ssget (append filter (list (cons 410 "Model")))))
    (progn (setq i 0) (repeat (sslength ss)
      (setq result (cons (tc:obj (ssname ss i)) result) i (1+ i))))) (reverse result))
(defun tc:pick (message types / hit obj)
  (if (setq hit (entsel message))
    (progn (setq obj (tc:obj (car hit)))
      (if (and types (not (member (vla-get-ObjectName obj) types)))
        (tc:fail "Loai doi tuong khong phu hop."))
      (if (/= (cdr (assoc 410 (entget (car hit)))) "Model") (tc:fail "Chi chon doi tuong Model space."))
      obj)))
(defun tc:layer (name color / layers obj)
  (if (or (= name "") (not (snvalid name))) (tc:fail "Ten layer khong hop le."))
  (setq layers (vla-get-Layers (tc:doc)))
  (if (tblsearch "LAYER" name) (setq obj (vla-item layers name))
    (progn (setq obj (tc:new (vla-add layers name))) (vla-put-Color obj color)))
  (if (or (= (vla-get-Lock obj) :vlax-true) (= (vla-get-Freeze obj) :vlax-true)
          (= (vla-get-LayerOn obj) :vlax-false))
    (tc:fail (strcat "Layer dang khoa/tat/dong bang: " name))) name)
(defun tc:writable (o / layer)
  (setq layer (vla-item (vla-get-Layers (tc:doc)) (vla-get-Layer o)))
  (if (= (vla-get-Lock layer) :vlax-true) (tc:fail "Doi tuong tren layer khoa.")) o)
(defun tc:put-layer (o layer) (vla-put-Layer o layer) (vla-put-Color o 256) o)
(defun tc:name (o) (if (vlax-property-available-p o 'EffectiveName) (vla-get-EffectiveName o) (vla-get-Name o)))
(defun tc:insertion (o) (tc:variant-list (vla-get-InsertionPoint o)))
(defun tc:dynprops (o)
  (if (and (vlax-property-available-p o 'IsDynamicBlock) (= (vla-get-IsDynamicBlock o) :vlax-true))
    (tc:variant-list (vla-GetDynamicBlockProperties o))))
(defun tc:dyn (o key / result p)
  (foreach p (tc:dynprops o)
    (if (= (strcase key) (strcase (vla-get-PropertyName p))) (setq result (vlax-variant-value (vla-get-Value p))))) result)
(defun tc:width-key (o)
  (cond ((numberp (tc:dyn o "Width1")) "Width1")
        ((numberp (tc:dyn o "Diameter")) "Diameter")
        ((numberp (tc:dyn o "Diameter1")) "Diameter1")
        (T (tc:fail (strcat "Block " (tc:name o) " thieu Width1/Diameter/Diameter1.")))))
(defun tc:second-width-key (o)
  (cond ((numberp (tc:dyn o "Width2")) "Width2")
        ((numberp (tc:dyn o "Diameter2")) "Diameter2")))
(defun tc:state (o state required / prop vals val found)
  ;; Visibility parameter labels vary. Resolve the property by its allowed state.
  (foreach prop (tc:dynprops o)
    (setq vals (tc:variant-list (vla-get-AllowedValues prop)))
    (foreach val vals
      (if (eq (type val) 'VARIANT) (setq val (vlax-variant-value val)))
      (if (and (eq (type val) 'STR) (= (strcase val) (strcase state)))
        (progn (tc:set-dyn o (vla-get-PropertyName prop) val T) (setq found T)))))
  (if (and required (not found)) (tc:fail (strcat "Block thieu trang thai " state))) found)
(defun tc:set-dyn (o key value required / found p allowed converted result)
  (foreach p (tc:dynprops o)
    (if (= (strcase key) (strcase (vla-get-PropertyName p)))
      (progn
        (if (= (vla-get-ReadOnly p) :vlax-true)
          (if required (tc:fail (strcat "Dynamic property chi doc: " key)))
          (progn
        (setq allowed (tc:variant-list (vla-get-AllowedValues p)))
        (if (and allowed (not (vl-some '(lambda (v) (equal (if (eq (type v) 'VARIANT) (vlax-variant-value v) v) value 0.000001)) allowed)))
          (tc:fail (strcat "Gia tri khong nam trong AllowedValues cua " key ": " (vl-princ-to-string value))))
        (setq converted (vlax-make-variant value (vlax-variant-type (vla-get-Value p))))
        (vla-put-Value p converted) (tc:touch) (vla-update o)
        (if (not (equal (tc:dyn o key) value 0.000001)) (tc:fail (strcat "Block tu choi gia tri " key)))
        (setq found T))))))
  (if (and required (not found)) (tc:fail (strcat "Block " (tc:name o) " thieu property " key))) found)
(defun tc:attributes (o / out a)
  (if (and (vlax-property-available-p o 'HasAttributes) (= (vla-get-HasAttributes o) :vlax-true))
    (foreach a (tc:variant-list (vla-GetAttributes o))
      (setq out (cons (cons (strcase (vla-get-TagString a)) (vla-get-TextString a)) out)))) (reverse out))
(defun tc:set-attributes (o pairs / a pair)
  (if (= (vla-get-HasAttributes o) :vlax-true)
    (foreach a (tc:variant-list (vla-GetAttributes o))
      (if (setq pair (assoc (strcase (vla-get-TagString a)) pairs))
        (progn (vla-put-TextString a (cdr pair)) (tc:touch))))) o)
(defun tc:size-label (w h) (strcat "W" (rtos w 2 0) "xH" (rtos h 2 0)))
(defun tc:block-height (o fallback / pair pos height text)
  (foreach pair (tc:attributes o)
    (setq text (strcase (cdr pair)) pos (vl-string-search "XH" text))
    (if pos (progn (setq height (atof (substr text (+ pos 3))))
      (if (> height 0.0) (setq fallback height))))) fallback)
(defun tc:inherit-service (o source / key value)
  (foreach key '("SYSTEM" "TC_ELEVATION")
    (if (setq value (tc:xget source key)) (tc:xset o key value))))
(defun tc:size-attributes (o w h / tag val)
  (setq val (tc:size-label w h))
  (tc:set-attributes o (mapcar '(lambda (tag) (cons tag val)) '("SIZE" "CABLETRAY" "TRUNKING" "LADDER" "DUCT"))))
(defun tc:xset (o key value / e data)
  (regapp key) (setq e (tc:ename o) data (entget e))
  (entmod (append data (list (list -3 (list key (cons 1000 value)))))) (tc:touch) value)
(defun tc:xget (o key / data app)
  (if (setq data (assoc -3 (entget (tc:ename o) (list key))))
    (cdr (assoc 1000 (cdadr data)))))
(defun tc:metadata (o system material dn w h / item)
  (foreach item (list (cons "TC_SYSTEM" system) (cons "VAT LIEU" material)
      (cons "SYSTEM" (tc:cfg 'service)) (cons "TC_DN" (rtos dn 2 3))
      (cons "TC_WIDTH" (rtos w 2 3)) (cons "TC_HEIGHT" (rtos h 2 3))
      (cons "TC_ELEVATION" (tc:cfg 'elevation)))
    (tc:xset o (car item) (cdr item))) o)
(defun tc:polyline (pts layer / obj flat)
  (setq pts (tc:dedup pts))
  (if (< (length pts) 2) (tc:fail "Tuyen can it nhat hai diem khac nhau."))
  (setq flat (apply 'append (mapcar '(lambda (p) (list (car p) (cadr p))) pts)))
  (setq obj (tc:new (vla-AddLightWeightPolyline (tc:space) (tc:array flat vlax-vbDouble))))
  (tc:put-layer obj layer) obj)
(defun tc:poly-points (o / e data pts pair)
  (if (/= (vla-get-ObjectName o) "AcDbPolyline") (tc:fail "Can LWPOLYLINE."))
  (if (= (vla-get-Closed o) :vlax-true) (tc:fail "Chi ho tro polyline mo."))
  (setq e (tc:ename o) data (entget e))
  (if (not (equal (cdr (assoc 210 data)) '(0.0 0.0 1.0) 0.00000001)) (tc:fail "Polyline phai nam tren WCS XY."))
  (foreach pair data
    (if (and (= (car pair) 42) (> (abs (cdr pair)) 0.000000001)) (tc:fail "Polyline co cung tron: hay chia thanh cac doan thang truoc."))
    (if (= (car pair) 10) (setq pts (cons (tc:xy-check (trans (append (cdr pair) (list (vla-get-Elevation o))) e 0)) pts))))
  (tc:dedup (reverse pts)))
(defun tc:pick-route ( / p q pts)
  (if (setq p (tc:point "\nDiem dau (Enter huy): "))
    (progn (setq pts (list p))
      (while (setq q (tc:next-point p "\nDiem tiep theo (Enter ket thuc): "))
        (if (> (tc:dist p q) 0.000001) (setq pts (append pts (list q)) p q))))) pts)
(defun tc:temp-delete (o)
  (if (and o (not (vlax-object-released-p o))) (vl-catch-all-apply 'vla-delete (list o))))
(defun tc:cleanup ( / o)
  (foreach o *tc-temps* (tc:temp-delete o)) (setq *tc-temps* nil)
  (if (and *tc-dbx* (not (vlax-object-released-p *tc-dbx*))) (vlax-release-object *tc-dbx*)) (setq *tc-dbx* nil))
(defun tc:run (fn / *error* doc saved result pair undo-ended undo-started)
  (setq doc (tc:doc) *tc-dirty* nil *tc-failure* nil *tc-temps* nil *tc-last-ok* nil *tc-last-message* "")
  (setq saved (mapcar '(lambda (name) (cons name (getvar name)))
    '("CMDECHO" "CLAYER" "CMLSTYLE" "CMLSCALE" "CMLJUST" "FILLETRAD" "OSMODE")))
  (defun *error* (msg)
    (setq *tc-last-ok* nil *tc-last-message* msg)
    (tc:cleanup)
    (foreach pair saved (vl-catch-all-apply 'setvar (list (car pair) (cdr pair))))
    (if (and undo-started (not undo-ended)) (vl-catch-all-apply 'vla-EndUndoMark (list doc)))
    (princ (strcat "\nTOOLS CAD: " msg " | Go U de hoan tac lenh neu can.")) (princ))
  (if (= (logand (getvar "UNDOCTL") 1) 0) (tc:fail "Bat UNDO truoc khi chay TOOLS CAD."))
  (tc:model-check) (vla-StartUndoMark doc) (setq undo-started T) (setvar "CMDECHO" 0)
  (setq result (vl-catch-all-apply fn nil))
  (tc:cleanup)
  (foreach pair saved (vl-catch-all-apply 'setvar (list (car pair) (cdr pair))))
  (vla-EndUndoMark doc) (setq undo-ended T)
  (setq *tc-last-ok* (not (vl-catch-all-error-p result))
    *tc-last-message* (if *tc-last-ok* "Tools Cad HL: hoan tat." (if *tc-failure* *tc-failure* (vl-catch-all-error-message result))))
  (if (vl-catch-all-error-p result)
    (progn
      (if *tc-dirty* (command-s "_.U"))
      (princ (strcat "\nTOOLS CAD: " (if *tc-failure* *tc-failure* (vl-catch-all-error-message result))
        (if *tc-dirty* " | Da hoan tac thay doi cua lenh." ""))))) (princ))
(tc:read-config)
(princ)

;;; ===== tc-library =====
;;; Named blocks are imported on demand from the user's Duy template.
(defun tc:library-path ( / candidates path)
  (if (and (boundp '*tc-template*) *tc-template* (findfile *tc-template*)) *tc-template*
    (progn
      (setq *tc-template* nil)
      (setq candidates (list (getenv "TOOLS_CAD_TEMPLATE") (findfile "template CAd Duy.dwg")
        (strcat (getvar "DWGPREFIX") "template CAd Duy.dwg")))
      (if (boundp '*tc-root*) (setq candidates (append candidates
        (list (strcat *tc-root* "/library/template CAd Duy.dwg") (strcat *tc-root* "/template CAd Duy.dwg")))))
      (foreach path candidates (if (and path (null *tc-template*) (findfile path)) (setq *tc-template* (findfile path))))
      (if (null *tc-template*) (setq *tc-template* (getfiled "Chon template CAd Duy.dwg lam thu vien block" "" "dwg" 0)))
      (if *tc-template* (setenv "TOOLS_CAD_TEMPLATE" *tc-template*)) *tc-template*)))
(defun tc:select-template ( / path)
  (if (setq path (getfiled "Chon dung template CAd Duy.dwg" "" "dwg" 0))
    (progn (setq *tc-template* path) (setenv "TOOLS_CAD_TEMPLATE" path)
      (princ (strcat "\nThu vien: " path)))))
(defun tc:dbx ( / app version result)
  (if (null *tc-dbx*)
    (progn
      (if (null (tc:library-path)) (tc:fail "Chua chon template CAd Duy.dwg."))
      (setq app (vlax-get-acad-object) version (substr (getvar "ACADVER") 1 2)
        result (vl-catch-all-apply 'vla-GetInterfaceObject (list app (strcat "ObjectDBX.AxDbDocument." version))))
      (if (vl-catch-all-error-p result)
        (tc:fail "Khong khoi tao duoc ObjectDBX. Can AutoCAD 2024 Windows ban day du."))
      (setq *tc-dbx* result)
      (setq result (vl-catch-all-apply 'vla-Open (list *tc-dbx* (tc:library-path))))
      (if (vl-catch-all-error-p result) (tc:fail (strcat "Khong mo duoc template: " (vl-catch-all-error-message result))))))
  *tc-dbx*)
(defun tc:block-present (name) (not (null (tblsearch "BLOCK" name))))
(defun tc:ensure-block (name / src result)
  (if (not (tc:block-present name))
    (progn
      (setq src (vl-catch-all-apply 'vla-Item (list (vla-get-Blocks (tc:dbx)) name)))
      (if (vl-catch-all-error-p src) (tc:fail (strcat "Template Duy khong co block: " name ". Dung TCBLOCK de kiem tra.")))
      (if (= (vla-get-IsXRef src) :vlax-true) (tc:fail "Khong nhap block Xref."))
      (setq result (vla-CopyObjects *tc-dbx* (tc:array (list src) vlax-vbObject) (vla-get-Blocks (tc:doc))))
      (tc:touch)
      (if (not (tc:block-present name)) (tc:fail (strcat "Khong nhap duoc block " name))))) name)
(defun tc:block-names (source / out blk name)
  (vlax-for blk (vla-get-Blocks source)
    (setq name (vla-get-Name blk))
    (if (and (/= (substr name 1 1) "*") (= (vla-get-IsXRef blk) :vlax-false))
      (setq out (cons name out))))
  (acad_strlsort out))
(defun tc:insert (name pt rotation layer / o)
  (tc:ensure-block name)
  (setq o (tc:new (vla-InsertBlock (tc:space) (tc:3d (tc:xy-check pt)) name 1.0 1.0 1.0 rotation)))
  (tc:put-layer o layer) o)
(defun tc:mline-style ( / dict style offsets pair)
  ;; Own fixed +/-0.5 style; protects against templates with different MC offsets.
  (setq dict (cdr (assoc -1 (dictsearch (namedobjdict) "ACAD_MLINESTYLE"))))
  (if (null dict)
    (progn (setq dict (entmakex '((0 . "DICTIONARY") (100 . "AcDbDictionary") (281 . 1))))
      (dictadd (namedobjdict) "ACAD_MLINESTYLE" dict) (tc:touch)))
  (if (not (dictsearch dict "TC_MC"))
    (progn (setq style (entmakex '((0 . "MLINESTYLE") (100 . "AcDbMlineStyle")
      (2 . "TC_MC") (70 . 0) (3 . "TOOLS CAD centreline +/-0.5") (62 . 256)
      (51 . 1.5707963267949) (52 . 1.5707963267949) (71 . 2)
      (49 . 0.5) (62 . 256) (6 . "BYLAYER") (49 . -0.5) (62 . 256) (6 . "BYLAYER"))))
      (if (null style) (tc:fail "Khong tao duoc MLINESTYLE TC_MC."))
      (dictadd dict "TC_MC" style) (tc:touch)))
  (setq style (dictsearch dict "TC_MC") offsets nil)
  (foreach pair style (if (= (car pair) 49) (setq offsets (cons (cdr pair) offsets))))
  (if (not (and (= (length offsets) 2) (member 0.5 offsets) (member -0.5 offsets)))
    (tc:fail "MLINESTYLE TC_MC da co nhung khong phai hai net +/-0.5. Kiem tra style truoc."))
  (setvar "CMLSTYLE" "TC_MC") "TC_MC")
(defun tc:mline (a b diameter layer / o)
  (if (<= (tc:dist a b) 0.000001) (tc:fail "Doan ong qua ngan."))
  (tc:mline-style) (setvar "CMLSCALE" diameter) (setvar "CMLJUST" 1)
  (setq o (tc:new (vla-AddMLine (tc:space) (tc:array (append a b) vlax-vbDouble))))
  (vla-put-MLineScale o diameter) (vla-put-Justification o 1)
  (tc:put-layer o layer) o)
(defun tc:explode-temp (o depth / result child out)
  (if (> depth 6) (tc:fail "Block long qua 6 cap, can kiem tra thu vien."))
  (setq result (vl-catch-all-apply 'vlax-invoke (list o 'Explode)))
  (if (vl-catch-all-error-p result) (tc:fail (strcat "Block khong cho explode: " (tc:name o))))
  (setq *tc-temps* (append result *tc-temps*))
  (foreach child result
    (if (= (vla-get-Visible child) :vlax-true)
      (if (= (vla-get-ObjectName child) "AcDbBlockReference")
        (setq out (append out (tc:explode-temp child (1+ depth))))
        (if (member (vla-get-ObjectName child)
          '("AcDbLine" "AcDbPolyline" "AcDb2dPolyline" "AcDbArc" "AcDbCircle" "AcDbEllipse" "AcDbSpline"))
          (setq out (cons child out)))))) out)
(defun tc:port (fitting target overlap / center direction ray children child raw pts p best dist limit saved-temps low high reach)
  ;; Intersect a ray with the current evaluated visible geometry, not an axis-aligned box.
  (setq center (tc:insertion fitting) direction (tc:unit (tc:v- target center))
        limit (tc:dist center target) saved-temps *tc-temps*)
  (if (null direction) (tc:fail "Diem xa cua ong trung tam fitting."))
  (vla-GetBoundingBox fitting 'low 'high)
  (setq reach (* 2.0 (max limit (tc:dist center (tc:variant-list low)) (tc:dist center (tc:variant-list high)))))
  (setq ray (vla-AddLine (tc:space) (tc:3d center) (tc:3d (tc:v+ center (tc:v* direction reach)))))
  (setq *tc-temps* (cons ray *tc-temps*) children (tc:explode-temp fitting 0) dist -1.0)
  (foreach child children
    (setq raw (vl-catch-all-apply 'vla-IntersectWith (list ray child 0)))
    (if (not (vl-catch-all-error-p raw))
      (progn (setq pts (tc:variant-list raw))
        (foreach p (tc:chunks pts 3)
          (if (> (tc:dist center p) (+ dist 0.000001))
            (setq best p dist (tc:dist center p)))))))
  (while (not (eq *tc-temps* saved-temps))
    (tc:temp-delete (car *tc-temps*)) (setq *tc-temps* (cdr *tc-temps*)))
  (if (null best) (tc:fail (strcat "Khong xac dinh duoc cong noi cua " (tc:name fitting)
    ". Kiem tra huong block/Visibility hoac chieu dai doan ong.")))
  (if (>= dist (- limit 0.000001)) (tc:fail (strcat "Doan qua ngan cho fitting " (tc:name fitting))))
  (tc:v- best (tc:v* direction (min overlap (* 0.9 dist)))))
(defun tc:inspect ( / o p a)
  (if (setq o (tc:pick "\nChon block de doc thuoc tinh: " '("AcDbBlockReference")))
    (progn (princ (strcat "\nBlock: " (tc:name o)))
      (foreach p (tc:dynprops o)
        (princ (strcat "\n  " (vla-get-PropertyName p) " = " (vl-princ-to-string (vlax-variant-value (vla-get-Value p)))
          " | Allowed: " (vl-princ-to-string (tc:variant-list (vla-get-AllowedValues p))))))
      (foreach a (tc:attributes o) (princ (strcat "\n  @" (car a) " = " (cdr a))))
      (princ (strcat "\n  SYSTEM=" (if (tc:xget o "SYSTEM") (tc:xget o "SYSTEM") "")
        " | VAT LIEU=" (if (tc:xget o "VAT LIEU") (tc:xget o "VAT LIEU") ""))))))
(princ)

;;; ===== tc-mep =====
;;; Route generation and explicit block-name rules from the supplied VBA.
(defun tc:pipe-p (system) (member system '("PPR" "UPVC" "STEEL")))
(defun tc:diameter (system dn / diam)
  (if (and (tc:pipe-p system) (not (and (equal dn (float (fix dn)) 0.00001) (member (fix dn) (tc:dn-values system)))))
    (tc:fail (strcat "D/DN khong nam trong kich thuoc template: " (vl-princ-to-string (tc:dn-values system)))))
  (if (= system "STEEL")
    (if (setq diam (tc:steel-d dn)) diam (tc:fail "DN thep ho tro: 15,20,25,32,40,50,65,80,100,125,150.")) dn))
(defun tc:material (system)
  (tc:canonical-material system (tc:cfg 'material)))
(defun tc:straight-name (system material)
  (cond ((= system "TRAY") material)
        ((= system "DUCT") (strcat "ONG GIO " material))))
(defun tc:prepare-cli (system / material layer)
  (if (member (tc:cfg 'layer) '("TC_PPR" "TC_UPVC" "TC_STEEL" "TC_TRAY" "TC_DUCT"))
    (tc:set 'layer (strcat "TC_" system)))
  (tc:set 'system system)
  (cond ((and (= system "PPR") (not (member (tc:cfg 'material) '("PPR" "HDPE")))) (tc:set 'material "PPR"))
    ((and (= system "UPVC") (not (member (tc:cfg 'material) '("UPVC" "UPVC_m")))) (tc:set 'material "UPVC"))
    ((= system "STEEL") (tc:set 'material "STK"))
    ((and (= system "TRAY") (not (member (tc:cfg 'material) '("Trunking" "Cable Tray" "Ladder")))) (tc:set 'material "Cable Tray"))
    ((and (= system "DUCT") (not (member (tc:cfg 'material) '("nep TDC" "nep C" "tron" "tieu am nep TDC" "cach nhiet nep TDC" "cach nhiet nep C")))) (tc:set 'material "nep TDC")))
  (if (tc:pipe-p system)
    (progn
      (if (not (member (fix (tc:cfg 'dn)) (tc:dn-values system))) (tc:set 'dn (if (= system "UPVC") 60.0 25.0)))
      (princ (strcat "\nKich thuoc co trong template: " (vl-princ-to-string (tc:dn-values system))))
      (tc:set 'dn (tc:positive "\nDuong kinh (thep nhap DN, nhua nhap D)" (tc:cfg 'dn))))
    (progn
      (if (= system "TRAY")
        (progn (prompt "\nVat lieu lay tu bang TOOLS: Cable Tray / Trunking / Ladder.")
          (setq material (getstring T (strcat "\nTen block thang <" (tc:cfg 'material) ">: ")))
          (if (/= material "") (tc:set 'material material)))
        (progn (setq material (getstring T (strcat "\nHau to block Ong gio (nep TDC/nep C/tron/tieu am nep TDC/cach nhiet nep TDC/cach nhiet nep C) <" (tc:cfg 'material) ">: ")))
          (if (/= material "") (tc:set 'material material))))
      (tc:set 'width (tc:positive "\nChieu rong/D ong gio tron" (tc:cfg 'width)))
      (tc:set 'height (tc:positive "\nChieu cao" (tc:cfg 'height)))))
  (setq layer (getstring T (strcat "\nLayer he thong <" (tc:cfg 'layer) ">: ")))
  (if (/= layer "") (tc:set 'layer layer))
  (tc:layer (tc:cfg 'layer) 3) (tc:save-config))
(defun tc:prepare (system)
  (if *tc-palette-input*
    (progn
      (tc:set 'system system)
      (if (null (tc:material system)) (tc:fail "Vat lieu khong hop le cho he thong."))
      (tc:set 'material (tc:material system))
      (tc:layer (tc:cfg 'layer) 3) (tc:save-config))
    (tc:prepare-cli system)))
(defun tc:setup-fitting (o system material dn width width2 height / label pair)
  (if (tc:pipe-p system)
    (progn (tc:set-dyn o "DN" dn nil) (tc:state o "SIDE" nil))
    (progn
      (if (and (null (tc:second-width-key o)) (not (equal width width2 0.01))) (tc:fail "Fitting khong co kich thuoc dau thu hai."))
      (foreach pair (tc:fitting-width-values system (tc:name o) width width2 (tc:width-key o) (tc:second-width-key o))
        (tc:set-dyn o (car pair) (cadr pair) T))
      (tc:size-attributes o width height)))
  (tc:metadata o system material dn width height) (tc:xset o "TC_FITTING" "1")
  (vla-update o) (entupd (tc:ename o)) o)
(defun tc:straight (a b system material dn width height layer / o diam)
  (setq a (tc:xy-check a) b (tc:xy-check b))
  (if (tc:pipe-p system)
    (setq o (tc:mline a b (tc:diameter system dn) layer))
    (progn
      (setq o (tc:insert (tc:straight-name system material) a (tc:angle a b) layer))
      (tc:set-dyn o (tc:width-key o) width T)
      (tc:set-dyn o "Length" (tc:dist a b) T)
      (tc:size-attributes o width height)))
  (tc:metadata o system material dn width height) o)
(defun tc:note (pts system material dn width height layer / a b p ang content obj)
  (if (= (tc:cfg 'note) "1")
    (progn (setq a (car pts) b (cadr pts) ang (tc:angle a b)
      p (tc:polar (tc:v* (tc:v+ a b) 0.5) (+ ang (/ pi 2.0)) (* 1.5 (tc:cfg 'text)))
      content (strcat material " " (if (tc:pipe-p system) (strcat (if (= system "STEEL") "DN" "D") (rtos dn 2 0))
        (tc:size-label width height)) " | " (tc:cfg 'service) " | " (if (/= (tc:cfg 'note-suffix) "") (tc:cfg 'note-suffix)
          (strcat "BOP/BOT=" (tc:cfg 'elevation) " FFL")))
      obj (tc:new (vla-AddText (tc:space) content (tc:3d p) (tc:cfg 'text))))
      (if (/= (tc:cfg 'note-prefix) "") (setq content (strcat (tc:cfg 'note-prefix) " " content)))
      (vla-put-TextString obj content)
      (if (or (> ang (/ pi 2.0)) (< ang (- (/ pi 2.0)))) (setq ang (+ ang pi)))
      (vla-put-Rotation obj ang) (tc:put-layer obj layer))))
(defun tc:build-route (pts system / material dn width height layer fits i degree name fit a b p q left right overlap runs)
  (setq pts (tc:simplify pts) material (tc:material system) dn (tc:cfg 'dn)
    width (tc:cfg 'width) height (tc:cfg 'height) layer (tc:cfg 'layer)
    overlap (if (= system "UPVC") (tc:cfg 'overlap) 0.0))
  (if (< (length pts) 2) (tc:fail "Can it nhat hai diem de tao tuyen."))
  ;; Preflight every name and turn before adding the first run.
  (if (not (tc:pipe-p system)) (tc:ensure-block (tc:straight-name system material)))
  (tc:diameter system dn)
  (setq i 1 fits (list nil))
  (while (< i (1- (length pts)))
    (setq degree (tc:corner (nth (1- i) pts) (nth i pts) (nth (1+ i) pts)))
    (if (null degree) (tc:fail "Tuyen chi ho tro co 45/90 do. Hay sua goc lech hoac chia tuyen."))
    (setq name (tc:elbow-name system material dn degree)) (tc:ensure-block name)
    (setq fit (tc:insert name (nth i pts) (tc:elbow-rotation (nth (1- i) pts) (nth i pts) (nth (1+ i) pts)) layer))
    (tc:setup-fitting fit system material dn width width height)
    (setq fits (append fits (list fit)) i (1+ i)))
  (setq fits (append fits (list nil)) i 0)
  (while (< i (1- (length pts)))
    (setq a (nth i pts) b (nth (1+ i) pts) left (nth i fits) right (nth (1+ i) fits)
      p (if left (tc:port left b overlap) a) q (if right (tc:port right a overlap) b))
    (if (<= (tc:dot (tc:v- q p) (tc:unit (tc:v- b a))) 0.0001)
      (tc:fail "Doan qua ngan: hai fitting chong lan. Tang chieu dai tuyen."))
    (setq runs (append runs (list (tc:straight p q system material dn width height layer)))) (setq i (1+ i)))
  (tc:note pts system material dn width height layer)
  (princ (strcat "\nDa tao " (itoa (1- (length pts))) " doan va " (itoa (- (length pts) 2)) " fitting.")) runs)
(defun tc:execute-route (system mode / existing objects obj pts picked runs endpoints)
  (if (= (tc:cfg 'auto-connect) "1") (setq existing (tc:existing-runs system)))
  (if (= mode "Polyline")
    (progn
      (setq objects (tc:selection '((0 . "LWPOLYLINE"))))
      (foreach obj objects (tc:poly-points obj))
      (foreach obj objects
        (setq pts (tc:poly-points obj) endpoints (append endpoints (list (car pts) (last pts)))
          runs (append runs (tc:build-route pts system)))))
    (if (and (setq picked (tc:pick-sized-route system)) (> (length (car picked)) 1))
      (setq pts (car picked) endpoints (list (car pts) (last pts))
        runs (tc:build-sized-route pts (cadr picked) system))))
  (if (and runs existing) (tc:connect-new-runs runs existing endpoints system))
  (if (and runs (= (tc:cfg 'erase) "1")) (foreach obj objects (tc:delete (tc:writable obj))))
  (tc:save-config) runs)
(defun tc:draw (system / mode)
  (tc:prepare system)
  (setq mode (if *tc-palette-input* (tc:cfg 'source) (tc:choose "\nNguon tuyen [Pick/Polyline]" "Pick Polyline" "Pick")))
  (tc:execute-route system mode))
(defun tc:pick-sized-route (system / p q pts sizes dims guide)
  ;; Size applies to the next segment. At a straight size transition a reducer is inserted.
  (if (setq p (tc:point "\nDiem dau (Enter huy): "))
    (progn
      (setq pts (list p))
      (while (progn (initget "Size Back")
        (setq q (getpoint (trans p 0 1) "\nDiem tiep / [Size/Back] (Enter ket thuc): ")))
        (cond
          ((eq (type q) 'STR)
            (if (= q "Size")
              (if (tc:pipe-p system)
                (tc:set 'dn (tc:positive "\nD/DN cho doan tiep theo" (tc:cfg 'dn)))
                (progn (tc:set 'width (tc:positive "\nRong/D doan tiep theo" (tc:cfg 'width)))
                  (tc:set 'height (tc:positive "\nCao doan tiep theo" (tc:cfg 'height)))))
              (if (cdr pts)
                (setq pts (reverse (cdr (reverse pts))) sizes (reverse (cdr (reverse sizes))) p (last pts)))))
          (T (setq q (tc:xy-check (trans q 1 0)))
            (tc:palette-live)
            (if (> (tc:dist p q) 0.000001)
              (setq pts (append pts (list q)) sizes (append sizes (list (list (tc:cfg 'dn) (tc:cfg 'width) (tc:cfg 'height)))) p q))))
        (if (> (length pts) 1)
          (if guide
            (vla-put-Coordinates guide (tc:array (apply 'append (mapcar '(lambda (pt) (list (car pt) (cadr pt))) pts)) vlax-vbDouble))
            (progn
              (setq guide (vla-AddLightWeightPolyline (tc:space) (tc:array (apply 'append (mapcar '(lambda (pt) (list (car pt) (cadr pt))) pts)) vlax-vbDouble)))
              (setq *tc-temps* (cons guide *tc-temps*)) (vla-put-Color guide 1)))
          (if guide (progn (tc:temp-delete guide) (setq *tc-temps* (vl-remove guide *tc-temps*) guide nil)))))
      (if guide (progn (tc:temp-delete guide) (setq *tc-temps* (vl-remove guide *tc-temps*)))))
    )
  (if pts (list pts sizes)))
(defun tc:sized-junction (system material previous current a b c / deg oldsize newsize name rot dn width1 width2 h)
  (setq deg (tc:corner a b c)
    oldsize (if (tc:pipe-p system) (car previous) (cadr previous))
    newsize (if (tc:pipe-p system) (car current) (cadr current)))
  (cond
    ((or (null deg) (and (/= deg 0) (not (equal oldsize newsize 0.01)))) 'unsupported)
    ((and (= deg 0) (equal oldsize newsize 0.01)) nil)
    (T
      (if (= deg 0)
        (setq name (if (tc:pipe-p system) (tc:branch-name system material "RED" (max oldsize newsize) (min oldsize newsize))
          (tc:trunk-fitting-name system material "RED"))
          rot (+ (tc:angle a b) (if (< oldsize newsize) pi 0.0)))
        (setq name (tc:elbow-name system material (car current) deg) rot (tc:elbow-rotation a b c)))
      (setq dn (max (car previous) (car current)) width1 (max (cadr previous) (cadr current))
        width2 (min (cadr previous) (cadr current)) h (max (caddr previous) (caddr current)))
      (list name rot dn width1 width2 h))))
(defun tc:build-sized-route (pts sizes system / material layer fits i spec fit a b p q overlap dims count runs)
  (setq material (tc:material system) layer (tc:cfg 'layer) fits (list nil) i 1 count 0
    overlap (if (= system "UPVC") (tc:cfg 'overlap) 0.0))
  (if (/= (length sizes) (1- (length pts))) (tc:fail "Du lieu kich thuoc tuyen khong khop so doan."))
  (if (not (tc:pipe-p system)) (tc:ensure-block (tc:straight-name system material)))
  (foreach dims sizes (tc:diameter system (car dims)))
  (while (< i (1- (length pts)))
    (setq spec (tc:sized-junction system material (nth (1- i) sizes) (nth i sizes)
      (nth (1- i) pts) (nth i pts) (nth (1+ i) pts)) fit nil)
    (if (eq spec 'unsupported) (tc:fail "Chi ho tro goc 45/90. Khi doi kich thuoc, tao mot doan thang rieng cho reducer."))
    (if spec
      (progn
        (setq fit (tc:insert (car spec) (nth i pts) (cadr spec) layer))
        (tc:setup-fitting fit system material (nth 2 spec) (nth 3 spec) (nth 4 spec) (nth 5 spec))
        (setq count (1+ count))))
    (setq fits (append fits (list fit)) i (1+ i)))
  (setq fits (append fits (list nil)) i 0)
  (while (< i (length sizes))
    (setq a (nth i pts) b (nth (1+ i) pts) dims (nth i sizes)
      p (if (nth i fits) (tc:port (nth i fits) b overlap) a)
      q (if (nth (1+ i) fits) (tc:port (nth (1+ i) fits) a overlap) b))
    (if (<= (tc:dot (tc:v- q p) (tc:unit (tc:v- b a))) 0.0001) (tc:fail "Hai fitting chong lan: doan qua ngan."))
    (setq runs (append runs (list (tc:straight p q system material (car dims) (cadr dims) (caddr dims) layer))))
    (if (or (= i 0) (not (equal dims (nth (1- i) sizes) 0.01)))
      (tc:note (list a b) system material (car dims) (cadr dims) (caddr dims) layer))
    (setq i (1+ i)))
  (princ (strcat "\nDa tao " (itoa (length sizes)) " doan, " (itoa count) " fitting; ho tro doi Size tren doan thang.")) runs)
(defun tc:convert (system)
  (tc:prepare system) (tc:execute-route system "Polyline"))
(defun tc:segment (o system / typ coords a b size dn width material h)
  (setq typ (vla-get-ObjectName o) material (tc:material system) h (tc:cfg 'height))
  (cond
    ((= typ "AcDbMline")
      (setq coords (tc:variant-list (vla-get-Coordinates o)))
      (if (/= (length coords) 6) (tc:fail "Noi tu dong chi ho tro MLINE 2 dinh."))
      (if (/= (vla-get-Justification o) 1) (tc:fail "MLINE phai co Justification = Zero (tam)."))
      (setq a (tc:xy-check (list (car coords) (cadr coords) (caddr coords))) b (tc:xy-check (cadr (tc:chunks coords 3)))
        width (abs (vla-get-MLineScale o)) dn (if (= system "STEEL") (tc:steel-dn width) width))
      (if (null dn) (tc:fail "Scale MLINE khong khop bang D/DN thep.")))
    ((= typ "AcDbBlockReference")
      (if (tc:pipe-p system) (tc:fail "Ong nhua/thep phai la MLINE."))
      (if (or (not (equal (vla-get-XScaleFactor o) 1.0 0.000001))
              (not (equal (vla-get-YScaleFactor o) 1.0 0.000001))
              (not (equal (tc:variant-list (vla-get-Normal o)) '(0.0 0.0 1.0) 0.00000001)))
        (tc:fail "Block thang phai co scale X=Y=1 va Normal WCS Z+."))
      (if (null (tc:dyn o "Length")) (tc:fail "Block thang thieu Length."))
      (setq a (tc:xy-check (tc:insertion o)) b (tc:polar a (vla-get-Rotation o) (tc:dyn o "Length"))
        width (tc:dyn o (tc:width-key o)) dn 0.0 h (tc:block-height o h))
      (if (= system "TRAY") (setq material (tc:canonical-material system (tc:name o))))
      (if (= system "DUCT") (setq material (tc:canonical-material system (tc:name o)))))
    (T (tc:fail "Chi chon MLINE hoac block thang dong.")))
  (if (or (<= (tc:dist a b) 0.000001) (<= width 0.0)) (tc:fail "Doan thang khong hop le."))
  (if (tc:pipe-p system) (tc:diameter system dn))
  (if (tc:xget o "VAT LIEU") (setq material (tc:canonical-material system (tc:xget o "VAT LIEU"))))
  (if (null material) (tc:fail "Khong nhan dien duoc vat lieu cua doan thang."))
  (if (tc:xget o "TC_HEIGHT") (setq h (atof (tc:xget o "TC_HEIGHT"))))
  (if (and (tc:xget o "TC_SYSTEM") (/= system (tc:xget o "TC_SYSTEM"))) (tc:fail "Hai he thong khong khop. Dung lenh dung he."))
  (list (cons 'obj o) (cons 'a a) (cons 'b b) (cons 'dn dn) (cons 'width width)
    (cons 'height h) (cons 'material material) (cons 'system system) (cons 'layer (vla-get-Layer o))))
(defun tc:s (seg key) (cdr (assoc key seg)))
(defun tc:endpoint-p (seg cp)
  (tc:terminal-p (tc:s seg 'a) (tc:s seg 'b) cp (tc:cfg 'endpoint-tol)))
(defun tc:cut-interval (seg fit cp / a b len u x p q overlap lo hi tol)
  (setq a (tc:s seg 'a) b (tc:s seg 'b) u (tc:unit (tc:v- b a)) len (tc:dist a b)
    x (tc:dot (tc:v- cp a) u) tol (tc:cfg 'endpoint-tol) lo 0.0 hi len
    overlap (if (= (tc:s seg 'system) "UPVC") (tc:cfg 'overlap) 0.0))
  (cond
    ((<= x tol)
      (setq q (tc:dot (tc:v- (tc:port fit b overlap) a) u) lo (min 0.0 q) p lo))
    ((>= x (- len tol))
      (setq p (tc:dot (tc:v- (tc:port fit a overlap) a) u) hi (max len p) q hi))
    (T
      (setq p (tc:dot (tc:v- (tc:port fit a overlap) a) u)
        q (tc:dot (tc:v- (tc:port fit b overlap) a) u))
      (if (or (< p 0.0) (> q len)) (tc:fail "Fitting chiem het doan chinh. Tang khoang cach nut noi."))))
  (if (or (< q p) (>= p hi) (<= q lo))
    (if (not (equal p q 0.000001)) (tc:fail "Fitting sai huong cong noi hoac vuot chieu dai doan.")))
  (list p q lo hi))
(defun tc:trim-segments (plans / entries plan seg obj entry cuts iv spans span a b u len new previous)
  ;; Collect every cut against original coordinates, then split each source once.
  (foreach plan plans
    (foreach seg (vl-remove nil (list (nth 2 plan) (nth 3 plan)))
      (setq obj (tc:s seg 'obj) entry (assoc (vla-get-Handle obj) entries)
        iv (tc:cut-interval seg (car plan) (cadr plan)))
      (if entry
        (foreach previous (caddr entry)
          (if (> (- (min (cadr iv) (cadr previous)) (max (car iv) (car previous))) 0.000001)
            (tc:fail "Hai fitting chong lan tren cung doan. Tang khoang cach nut noi."))))
      (if entry
        (setq entries (subst (list (car entry) seg (cons iv (caddr entry))
          (min (nth 3 entry) (nth 2 iv)) (max (nth 4 entry) (nth 3 iv))) entry entries))
        (setq entries (cons (list (vla-get-Handle obj) seg (list iv) (nth 2 iv) (nth 3 iv)) entries)))))
  (foreach entry entries
    (setq seg (cadr entry) a (tc:s seg 'a) b (tc:s seg 'b) u (tc:unit (tc:v- b a)) len (tc:dist a b)
      spans (tc:complement (caddr entry) (nth 3 entry) (nth 4 entry)))
    (if (null spans) (tc:fail "Fitting chiem het doan. Tang khoang cach nut noi."))
    (foreach span spans
      (setq new (vla-Copy (tc:writable (tc:s seg 'obj)))) (tc:new new)
      (if (= (vla-get-ObjectName new) "AcDbMline")
        (vla-put-Coordinates new (tc:array (append (tc:v+ a (tc:v* u (car span))) (tc:v+ a (tc:v* u (cadr span)))) vlax-vbDouble))
        (progn (vla-put-InsertionPoint new (tc:3d (tc:v+ a (tc:v* u (car span)))))
          (tc:set-dyn new "Length" (- (cadr span) (car span)) T))))
    (tc:delete (tc:s seg 'obj))))
(defun tc:autofit (system / first branches second main seg plans obj mode plan)
  (tc:set 'system system)
  (setq first (tc:pick "\nChon doan chinh: " '("AcDbMline" "AcDbBlockReference")))
  (if first
    (progn (setq main (tc:segment first system)
      mode (if *tc-palette-input* (tc:cfg 'fit-mode) (tc:choose "\nChe do [Pair/Batch]" "Pair Batch" "Pair")))
      (if (= mode "Batch")
        (setq branches (tc:selection (if (tc:pipe-p system) '((0 . "MLINE")) '((0 . "INSERT")))))
        (if (setq second (tc:pick "\nChon doan thu hai: " '("AcDbMline" "AcDbBlockReference"))) (setq branches (list second))))
      (foreach obj branches
        (if (/= (vla-get-Handle first) (vla-get-Handle obj))
          (progn
            (setq seg (tc:segment obj system) plan (tc:fit-pair main seg))
            (tc:inherit-service (car plan) (tc:s (nth 2 plan) 'obj))
            (if (vl-some '(lambda (p) (< (tc:dist (cadr p) (cadr plan)) 0.1)) plans)
              (tc:fail "Nhieu nhanh trung nut. Tach xu ly nut Cross/phan nhanh, tranh hai fitting trung nhau."))
            (setq plans (cons plan plans)))))
      (if plans (progn (if (= (tc:cfg 'trim) "1") (tc:trim-segments plans)) (princ (strcat "\nDa noi " (itoa (length plans)) " nut.")))))))
(defun tc:manual-fitting ( / sys mat kind name dn d2 width fit pt rot)
  (setq sys (tc:cfg 'system) mat (tc:material sys) dn (tc:cfg 'dn) width (tc:cfg 'width))
  (if (tc:pipe-p sys) (tc:diameter sys dn))
  (setq kind (tc:choose "\nLoai [Elb90/Elb45/Tee/Y/Red/Cross/Name]" "Elb90 Elb45 Tee Y Red Cross Name" "Elb90"))
  (cond ((= kind "Name") (setq name (getstring T "\nTen block chinh xac: ")))
    ((member kind '("Elb90" "Elb45")) (setq name (tc:elbow-name sys mat dn (if (= kind "Elb45") 45 90))))
    (T (setq d2 (tc:positive "\nDuong kinh/rong nhanh" (if (tc:pipe-p sys) dn width)))
      (setq name (if (tc:pipe-p sys) (tc:branch-name sys mat (strcase kind) dn d2)
        (tc:trunk-fitting-name sys mat (strcase kind))))))
  (if (or (null name) (= name "")) (tc:fail "To hop phu kien/he thong chua duoc ho tro. Dung TCBLOCK de chon block cu the."))
  (if (setq pt (tc:point "\nDiem chen: "))
    (progn (setq rot (getangle (trans pt 0 1) "\nGoc xoay <0>: "))
      (setq rot (if rot (tc:angle pt (trans (polar (trans pt 0 1) rot 1.0) 1 0)) 0.0)
        fit (tc:insert name pt rot (tc:layer (tc:cfg 'layer) 3)))
      (tc:setup-fitting fit sys mat dn width (if d2 d2 width) (tc:cfg 'height)))))
(defun tc:upvc-rise (double / ml picked seg cp far rotation dn name fit fit2)
  (if (setq picked (entsel "\nPick gan dau MLINE UPVC: "))
    (progn (setq ml (tc:obj (car picked)) seg (tc:segment ml "UPVC") dn (tc:s seg 'dn)
      cp (tc:near-end (trans (cadr picked) 1 0) (tc:s seg 'a) (tc:s seg 'b))
      far (tc:far-end cp (tc:s seg 'a) (tc:s seg 'b)) rotation (+ (tc:angle cp far) pi)
      name (tc:elbow-name "UPVC" "UPVC" dn 45)
      fit (tc:insert name cp rotation (tc:s seg 'layer)))
      (tc:state fit (if double "UP90" "DN45") T)
      (tc:metadata fit "UPVC" "UPVC" dn 0.0 0.0)
      (if double
        (progn (setq fit2 (tc:insert name (tc:polar cp (tc:angle cp far) (* dn 2.0)) rotation (tc:s seg 'layer)))
          (tc:state fit2 "UP45" T) (tc:metadata fit2 "UPVC" "UPVC" dn 0.0 0.0))))))
(defun tc:split-duct ( / objs o seg maxlen len start new span u a)
  (setq maxlen (tc:positive "\nChieu dai moi doan ong gio" 1200.0) objs (tc:selection '((0 . "INSERT"))))
  (foreach o objs
    (setq seg (tc:segment o "DUCT") len (tc:dist (tc:s seg 'a) (tc:s seg 'b)) start 0.0
      u (tc:unit (tc:v- (tc:s seg 'b) (tc:s seg 'a))) a (tc:s seg 'a))
    (if (> len maxlen)
      (progn
        (while (< start (- len 0.000001))
          (setq span (min maxlen (- len start)) new (tc:new (vla-Copy (tc:writable o))))
          (vla-put-InsertionPoint new (tc:3d (tc:v+ a (tc:v* u start))))
          (tc:set-dyn new "Length" span T) (setq start (+ start span)))
        (tc:delete o)))))
(princ)

;;; ===== tc-junctions =====
;;; Pure junction plan followed by one database insertion.
(defun tc:plan-error (message) (list (cons 'error message)))
(defun tc:plan-pair (s1 s2 / a b c d cp ang end1 end2 kind rot name sys mat dn1 dn2 w1 w2 far1 far2 pair best mirror tol problem delegated)
  (setq a (tc:s s1 'a) b (tc:s s1 'b) c (tc:s s2 'a) d (tc:s s2 'b)
    sys (tc:s s1 'system) mat (tc:s s1 'material) dn1 (tc:s s1 'dn) dn2 (tc:s s2 'dn)
    w1 (tc:s s1 'width) w2 (tc:s s2 'width) mirror 1.0 tol (tc:cfg 'endpoint-tol)
    ang (* 180.0 (/ (tc:line-angle a b c d) pi)))
  (cond
    ((/= mat (tc:s s2 'material)) (setq problem "Hai doan khac vat lieu."))
    ((< ang 0.1)
      (cond
        ((equal w1 w2 0.01) (setq problem "Hai doan dong truc cung kich thuoc khong can reducer."))
        ((< w1 w2) (setq delegated (tc:plan-pair s2 s1)))
        ((> (tc:dist c (tc:project c a b nil)) tol) (setq problem "Reducer can hai doan dong truc."))
        (T
          (setq best (list a c))
          (foreach pair (list (list a d) (list b c) (list b d))
            (if (< (tc:dist (car pair) (cadr pair)) (tc:dist (car best) (cadr best))) (setq best pair)))
          (setq cp (car best) far1 (tc:far-end cp a b) far2 (tc:far-end (cadr best) c d))
          (cond
            ((> (tc:dist (car best) (cadr best)) (tc:cfg 'gap)) (setq problem "Khoang cach hai dau vuot sai so noi."))
            ((>= (tc:dot (tc:v- far1 cp) (tc:v- far2 cp)) 0.0) (setq problem "Hai doan reducer phai o hai phia nut noi."))
            (T (setq kind "RED" rot (tc:angle far1 far2)))))))
    ((not (or (< (abs (- ang 45.0)) 0.1) (< (abs (- ang 90.0)) 0.1))) (setq problem "Chi ho tro nut 45/90 do."))
    (T
      (setq cp (tc:intersection a b c d))
      (if (or (null cp) (> (tc:dist cp (tc:project cp a b T)) (tc:cfg 'gap))
          (> (tc:dist cp (tc:project cp c d T)) (tc:cfg 'gap)))
        (setq problem "Nut giao nam ngoai sai so noi.")
        (progn
          (setq end1 (tc:terminal-p a b cp tol) end2 (tc:terminal-p c d cp tol)
            far1 (tc:far-end cp a b) far2 (tc:far-end cp c d))
          (cond
            ((and end1 end2)
              (if (not (equal w1 w2 0.01)) (setq problem "Co can hai dau cung kich thuoc; chen reducer rieng.")
                (setq kind (if (> ang 89.9) "ELB90" "ELB45") rot (tc:elbow-rotation far1 cp far2))))
            ((and (not end1) (not end2))
              (if (and (= sys "TRAY") (> ang 89.9)) (setq kind "CROSS" rot (tc:angle a b))
                (setq problem "Nut cross tu dong chi ho tro mang cap 90 do.")))
            ((and end1 (not end2)) (setq delegated (tc:plan-pair s2 s1)))
            (T
              (setq kind (if (> ang 89.9)
                (if (and (= sys "DUCT") (= (tc:cfg 'duct-branch) "SHOE") (/= (strcase mat) "TRON")) "SHOE" "TEE") "Y"))
              (if (= kind "Y")
                (if (or (= sys "TRAY") (and (= sys "DUCT") (null (tc:trunk-fitting-name sys mat "Y"))))
                  (setq problem "Template khong co chac 45 do cho vat lieu nay.")
                  (progn
                    (setq rot (tc:angle a b))
                    (if (< (tc:dot (tc:v- far2 cp) (tc:v- b a)) 0.0) (setq rot (+ rot pi)))
                    (if (> (tc:wrap (- (tc:angle cp far2) rot)) 0.0) (setq mirror -1.0))))
                (progn (setq rot (tc:angle cp far2))
                  (if (and (= kind "SHOE") (= (tc:cfg 'fit-flip) "1")) (setq mirror -1.0))))))))))
  (cond
    (problem (tc:plan-error problem))
    (delegated delegated)
    ((null kind) (tc:plan-error "Khong xac dinh duoc loai phu kien."))
    (T
      (setq name (tc:fitting-name sys mat kind dn1 dn2))
      (if (null name) (tc:plan-error "Template khong co loai phu kien cho he nay.")
        (list (cons 'name name) (cons 'kind kind) (cons 'point cp) (cons 'rotation rot)
          (cons 'mirror mirror) (cons 's1 s1) (cons 's2 s2))))))
(defun tc:fit-pair (s1 s2 / plan fit)
  (setq plan (tc:plan-pair s1 s2))
  (if (assoc 'error plan) (tc:fail (cdr (assoc 'error plan))))
  (setq s1 (tc:s plan 's1) s2 (tc:s plan 's2)
    fit (tc:insert (tc:s plan 'name) (tc:s plan 'point) (tc:s plan 'rotation) (tc:s s1 'layer)))
  (if (< (tc:s plan 'mirror) 0.0) (vla-put-YScaleFactor fit -1.0))
  (tc:setup-fitting fit (tc:s s1 'system) (tc:s s1 'material) (tc:s s1 'dn)
    (tc:s s1 'width) (tc:s s2 'width) (tc:s s1 'height))
  (tc:inherit-service fit (tc:s s1 'obj))
  (list fit (tc:s plan 'point) s1 s2))
(defun tc:duct-fitting (kind shape / material name)
  ;; Dedicated insertion commands: these do not require an existing main/branch pair.
  (setq material (tc:canonical-material "DUCT" (tc:cfg 'material)))
  (if (= shape "ROUND") (setq material "tron")
    (if (or (null material) (= material "tron")) (setq material "nep TDC")))
  (tc:set 'system "DUCT") (tc:set 'material material) (tc:set 'fit-kind kind) (tc:set 'fit-state "")
  (if (member (tc:cfg 'layer) '("TC_PPR" "TC_UPVC" "TC_STEEL" "TC_TRAY")) (tc:set 'layer "TC_DUCT"))
  (if (not *tc-palette-input*)
    (progn
      (tc:set 'fit-width (tc:positive "\nRong/D ong chinh" (tc:cfg 'fit-width)))
      (tc:set 'fit-width2 (tc:positive "\nRong/D nhanh" (tc:cfg 'fit-width2)))
      (tc:set 'fit-height (tc:positive "\nCao ong gio" (tc:cfg 'fit-height)))))
  (setq name (tc:fitting-name "DUCT" material kind 0.0 0.0))
  (if (null name) (tc:fail "Template khong co chac nay cho vat lieu dang chon. Chac Y chi co ong chu nhat khong bao on."))
  (princ (strcat "\nDat truc tiep: " name))
  (tc:palette-fitting))
(defun tc:upvc-double (down / picked seg cp far rotation dn name fit second)
  (if (setq picked (entsel "\nPick gan dau MLINE UPVC: "))
    (progn
      (setq seg (tc:segment (tc:obj (car picked)) "UPVC") dn (tc:s seg 'dn)
        cp (tc:near-end (trans (cadr picked) 1 0) (tc:s seg 'a) (tc:s seg 'b))
        far (tc:far-end cp (tc:s seg 'a) (tc:s seg 'b)) rotation (+ (tc:angle cp far) pi)
        name (tc:elbow-name "UPVC" "UPVC" dn 45)
        fit (tc:insert name cp rotation (tc:s seg 'layer))
        second (tc:insert name (tc:polar cp (tc:angle cp far) (* dn 2.0)) rotation (tc:s seg 'layer)))
      (tc:setup-fitting fit "UPVC" (tc:s seg 'material) dn dn dn 0.0)
      (tc:setup-fitting second "UPVC" (tc:s seg 'material) dn dn dn 0.0)
      (tc:state fit (if down "DN90" "UP90") T)
      (tc:state second (if down "DN45" "UP45") T)
      (if (= (tc:cfg 'fit-flip) "1")
        (progn (vla-put-YScaleFactor fit -1.0) (vla-put-YScaleFactor second -1.0)))
      (princ "\nDa dat cap loi theo ky hieu 2D cua VBA; khong suy dien chieu cao ong dung."))))
(defun tc:catalog-fitting (fit sys mat dn width width2 height / key)
  ;; Catalog blocks can be grilles/valves without a second port or a width parameter.
  (foreach key '("Width1" "Width" "Diameter") (if (numberp (tc:dyn fit key)) (tc:set-dyn fit key width T)))
  (foreach key '("Width2" "Diameter2") (if (numberp (tc:dyn fit key)) (tc:set-dyn fit key width2 T)))
  (if (numberp (tc:dyn fit "Diameter1"))
    (tc:set-dyn fit "Diameter1" (if (numberp (tc:dyn fit "Width1")) width2 width) T))
  (if (numberp (tc:dyn fit "Height")) (tc:set-dyn fit "Height" height T))
  (tc:size-attributes fit width height) (tc:metadata fit sys mat dn width height) (tc:xset fit "TC_FITTING" "1"))
(defun tc:manual-trim (fit pt sys / objects obj seg plans)
  (princ "\nChon cac doan thang can ngat tai phu kien, Enter bo qua: ")
  (setq objects (tc:selection (if (tc:pipe-p sys) '((0 . "MLINE")) '((0 . "INSERT")))))
  (foreach obj objects
    (if (/= (vla-get-Handle obj) (vla-get-Handle fit))
      (progn (setq seg (tc:segment obj sys))
        (if (> (tc:dist pt (tc:project pt (tc:s seg 'a) (tc:s seg 'b) T)) (tc:cfg 'gap))
          (tc:fail "Doan da chon khong di qua nut phu kien trong sai so noi."))
        (setq plans (cons (list fit pt seg nil) plans)))))
  (if plans (tc:trim-segments plans)))
(defun tc:palette-fitting ( / sys mat kind dn dn2 width width2 height name pt angle fit states found state extra)
  (setq sys (tc:cfg 'system) mat (tc:canonical-material sys (tc:cfg 'material)) kind (tc:cfg 'fit-kind)
    dn (tc:cfg 'fit-dn) dn2 (tc:cfg 'dn2) width (tc:cfg 'fit-width) width2 (tc:cfg 'fit-width2) height (tc:cfg 'fit-height))
  (if (member kind '("DOUBLEUP" "DOUBLEDOWN")) (progn (tc:upvc-double (= kind "DOUBLEDOWN")) (setq kind nil)))
  (if kind (progn
  (if (tc:pipe-p sys) (progn (tc:diameter sys dn) (tc:diameter sys dn2)))
  (setq name (tc:fitting-name sys mat kind dn dn2))
  (if (null name) (tc:fail "Template khong co to hop phu kien/vat lieu nay."))
  (tc:ensure-block name)
  (if (setq pt (tc:point "\nDiem dat phu kien: "))
    (progn
      (setq angle (getangle (trans pt 0 1) "\nHuong phu kien <0>: "))
      (setq angle (if angle (tc:angle pt (trans (polar (trans pt 0 1) angle 1.0) 1 0)) 0.0)
        fit (tc:insert name pt angle (tc:layer (tc:cfg 'layer) 3)))
      (if (= (substr kind 1 6) "BLOCK|") (tc:catalog-fitting fit sys mat dn width width2 height)
        (progn
          (if (and (not (tc:pipe-p sys)) (null (tc:second-width-key fit))) (setq width2 width))
          (tc:setup-fitting fit sys mat dn width width2 height)))
      (if (and (tc:pipe-p sys) (member kind '("UP90" "DOWN90" "UP45" "DOWN45")))
        (progn
          (setq states (cond ((= kind "UP90") '("UP90" "UP")) ((= kind "DOWN90") '("DN90" "DOWN"))
            ((= kind "UP45") '("UP45" "UP")) (T '("DN45" "DOWN"))))
          (foreach state states (if (not found) (setq found (tc:state fit state nil))))
          (if (not found) (tc:fail "Block khong co trang thai len/xuong da chon."))))
      (if (= kind "RISER") (tc:state fit "TOP90" T))
      (if (/= (tc:cfg 'fit-state) "") (tc:state fit (tc:cfg 'fit-state) T))
      (if (= (tc:cfg 'fit-flip) "1") (vla-put-YScaleFactor fit -1.0))
      (if (= kind "YUP")
        (progn
          (setq extra (tc:point "\nDiem dat loi UP45 tren nhanh Y (ky hieu 2D): "))
          (if extra
            (progn
              (setq extra (tc:insert (tc:elbow-name sys mat dn2 45) extra angle (vla-get-Layer fit)))
              (tc:setup-fitting extra sys mat dn2 dn2 dn2 height) (tc:state extra "UP45" T)))))
      (if (and (= (tc:cfg 'trim) "1") (/= (substr kind 1 6) "BLOCK|")
          (not (member kind '("UP90" "DOWN90" "UP45" "DOWN45" "RISER" "YUP")))
          (member (tc:cfg 'fit-state) '("" "SIDE")))
        (tc:manual-trim fit pt sys)))))))
(defun tc:existing-runs (system / objects obj result segment known)
  (setq objects (ssget "_X" (list '(0 . "INSERT,MLINE") '(410 . "Model") (cons 8 (tc:cfg 'layer)))))
  (if objects
    (foreach *tc-candidate-id* (vl-remove-if 'listp (mapcar 'cadr (ssnamex objects)))
      (setq obj (tc:obj *tc-candidate-id*) known (tc:entity-system obj))
      (if (and (or (= known system) (= known "UNCLASSIFIED"))
        (or (and (tc:pipe-p system) (= (vla-get-ObjectName obj) "AcDbMline"))
            (and (not (tc:pipe-p system)) (= (vla-get-ObjectName obj) "AcDbBlockReference") (tc:straight-block-p (tc:name obj)))))
        (progn
          (setq segment (vl-catch-all-apply 'tc:segment (list obj system)))
          (if (not (vl-catch-all-error-p segment)) (setq result (cons segment result)))
          (setq *tc-failure* nil))))) result)
(defun tc:occupied-junction (cp / objects index obj name found)
  (setq objects (ssget "_X" (list '(0 . "INSERT") '(410 . "Model") (cons 8 (tc:cfg 'layer)))) index 0)
  (if objects
    (repeat (sslength objects)
      (setq obj (tc:obj (ssname objects index)) name (strcase (tc:name obj)) index (1+ index))
      (if (and (< (tc:dist cp (tc:insertion obj)) (tc:cfg 'endpoint-tol))
        (or (tc:xget obj "TC_FITTING") (wcmatch name "ELB*,TEE-*,Y-D*,RED-D*,ELBOW *,TEE *,CROSS *,CO *,CHAC *,CON GIAM*,CON TRON*")))
        (setq found T)))) found)
(defun tc:connect-new-runs (runs existing endpoints system / obj seg endpoint original candidate plan best bestdistance distance plans chosen records record key)
  (foreach obj runs
    (setq seg (tc:segment obj system))
    (foreach endpoint (list (tc:s seg 'a) (tc:s seg 'b))
      (if (vl-some '(lambda (p) (< (tc:dist p endpoint) (tc:cfg 'endpoint-tol))) endpoints)
        (progn
          (setq best nil bestdistance nil)
          (foreach candidate existing
            (if (and (= (tc:s candidate 'material) (tc:s seg 'material))
                (<= (tc:dist endpoint (tc:project endpoint (tc:s candidate 'a) (tc:s candidate 'b) T)) (tc:cfg 'gap)))
              (progn
                (setq plan (tc:plan-pair candidate seg))
                (if (not (assoc 'error plan))
                  (progn
                    (setq distance (tc:dist endpoint (tc:s plan 'point)))
                    (if (<= distance (tc:cfg 'gap))
                      (cond
                        ((or (null bestdistance) (< distance (- bestdistance 0.01))) (setq best candidate bestdistance distance))
                        ((and (< (abs (- distance bestdistance)) 0.01) (/= (vla-get-Handle (tc:s best 'obj)) (vla-get-Handle (tc:s candidate 'obj))))
                          (tc:fail "Dau tuyen cham nhieu tuyen chinh. Dung Tu dong ket phu kien de chon ro tuyen.")))))))))
          (if best
            (progn
              (setq plan (tc:plan-pair best seg))
              (if (tc:occupied-junction (tc:s plan 'point)) (tc:fail "Nut da co phu kien. Chon nut rieng de tranh chen trung."))
              (setq key (list (vla-get-Handle obj) (vla-get-Handle (tc:s best 'obj)) (tc:s plan 'point)))
              (if (not (member key chosen))
                (progn (setq plans (cons (tc:fit-pair best seg) plans) chosen (cons key chosen))))))))))
  (if plans
    (progn (if (= (tc:cfg 'trim) "1") (tc:trim-segments plans))
      (princ (strcat "\nDa tu noi " (itoa (length plans)) " nut vao tuyen co san.")))) plans)
(princ)
(princ)

;;; ===== tc-blocks =====
;;; Block editing, placement and definition tools.
(defun tc:clone-at (source point / copy)
  (setq copy (tc:new (vla-Copy source)))
  (vla-Move copy (tc:3d (tc:insertion source)) (tc:3d point)) copy)
(defun tc:block-grid ( / sample a b cols rows mode dx dy nx ny pts p width height)
  (if (and (setq sample (tc:pick "\nBlock mau: " '("AcDbBlockReference")))
           (setq a (tc:point "\nGoc thu nhat vung bo tri: "))
           (setq b (tc:next-point a "\nGoc doi dien: ")))
    (progn
      (setq width (abs (- (car b) (car a))) height (abs (- (cadr b) (cadr a))))
      (if (or (< width 0.000001) (< height 0.000001)) (tc:fail "Vung bo tri phai co chieu rong va cao."))
      (setq mode (tc:choose "\nBo tri [Count/Spacing]" "Count Spacing" "Count"))
      (if (= mode "Count")
        (progn
          (setq cols (tc:integer "\nSo cot" 3) rows (tc:integer "\nSo hang" 2))
          (if (> (* (float cols) rows) 10000) (tc:fail "Gioi han 10000 block moi lenh."))
          (setq pts (tc:grid a b cols rows)))
        (progn
          (setq dx (tc:positive "\nKhoang cach cot" 2000.0) dy (tc:positive "\nKhoang cach hang" 2000.0)
            cols (max 1 (fix (/ width dx))) rows (max 1 (fix (/ height dy))) nx 0 pts nil)
          (if (> (* (float cols) rows) 10000) (tc:fail "Gioi han 10000 block moi lenh."))
          (repeat rows (setq ny 0)
            (repeat cols
              (setq p (list (+ (min (car a) (car b)) (/ (- width (* (1- cols) dx)) 2.0) (* ny dx))
                (+ (min (cadr a) (cadr b)) (/ (- height (* (1- rows) dy)) 2.0) (* nx dy)) 0.0)
                pts (cons p pts) ny (1+ ny))) (setq nx (1+ nx)))))
      (if (> (length pts) 10000) (tc:fail "Gioi han 10000 block moi lenh. Giam so hang/cot."))
      (foreach p pts (tc:clone-at sample p))
      (princ (strcat "\nDa bo tri " (itoa (length pts)) " block, giu dynamic va attributes cua mau.")))))
(defun tc:block-align ( / objs base a b axis origin mode spacing projections pair index anchor target)
  (setq objs (tc:selection '((0 . "INSERT"))))
  (if objs
    (progn
      (setq base (tc:pick "\nBlock neo (giu nguyen vi tri): " '("AcDbBlockReference"))
        origin (if base (tc:xy-check (tc:insertion base))))
      (if (and base (not (vl-some '(lambda (o) (= (vla-get-Handle o) (vla-get-Handle base))) objs)))
        (tc:fail "Block neo phai nam trong nhom da chon."))
      (if (and origin (setq a (tc:point "\nDiem thu nhat xac dinh huong truc: "))
               (setq b (tc:next-point a "\nDiem thu hai xac dinh huong truc: ")))
        (progn
          (setq axis (tc:unit (tc:v- b a))) (if (null axis) (tc:fail "Truc chuan co do dai bang 0."))
          (setq mode (tc:choose "\nCan hang [Project/Equal/Round]" "Project Equal Round" "Project"))
          (if (/= mode "Project") (setq spacing (tc:positive "\nKhoang cach / buoc lam tron" 100.0)))
          (foreach pair objs (setq projections (cons (cons (tc:dot (tc:v- (tc:insertion pair) origin) axis) pair) projections)))
          (setq projections (tc:sort projections '(lambda (x y) (< (car x) (car y)))) index 0 anchor 0)
          (foreach pair projections
            (if (= (vla-get-Handle (cdr pair)) (vla-get-Handle base)) (setq anchor index))
            (setq index (1+ index))) (setq index 0)
          (foreach pair projections
            (if (/= (vla-get-Handle (cdr pair)) (vla-get-Handle base))
              (progn
                (setq target (tc:v+ origin (tc:v* axis
                  (cond ((= mode "Equal") (* (- index anchor) spacing))
                        ((= mode "Round") (* spacing (tc:round-int (/ (car pair) spacing)))) (T (car pair))))))
                (vla-Move (tc:writable (cdr pair)) (tc:3d (tc:insertion (cdr pair))) (tc:3d target)) (tc:touch)))
            (setq index (1+ index))))))))
(defun tc:round-int (x) (if (< x 0.0) (- (fix (+ (- x) 0.5))) (fix (+ x 0.5))))
(defun tc:copy-dyn (source target / p key val)
  (foreach p (tc:dynprops source)
    (setq key (vla-get-PropertyName p) val (vlax-variant-value (vla-get-Value p)))
    (if (and (= (vla-get-ReadOnly p) :vlax-false) (not (null (tc:dyn target key))))
      (tc:set-dyn target key val nil))) target)
(defun tc:block-replace ( / sample objs source new mode oldname)
  (if (setq sample (tc:pick "\nChon block mau thay the: " '("AcDbBlockReference")))
    (progn
      (setq mode (tc:choose "\nPham vi [Selection/Name]" "Selection Name" "Selection"))
      (if (= mode "Name")
        (progn (setq source (tc:pick "\nChon block co ten can thay toan bo Model: " '("AcDbBlockReference")))
          (if source
            (progn (setq oldname (tc:name source))
              (vlax-for source (tc:space)
                (if (and (= (vla-get-ObjectName source) "AcDbBlockReference") (= (strcase (tc:name source)) (strcase oldname)))
                  (setq objs (cons source objs)))))))
        (setq objs (tc:selection '((0 . "INSERT")))))
      (foreach source objs
        (if (/= (vla-get-Handle source) (vla-get-Handle sample))
          (progn
            (tc:writable source) (setq new (tc:clone-at sample (tc:insertion source)))
            (vla-put-Layer new (vla-get-Layer source)) (vla-put-Rotation new (vla-get-Rotation source))
            (vla-put-XScaleFactor new (vla-get-XScaleFactor source))
            (vla-put-YScaleFactor new (vla-get-YScaleFactor source)) (vla-put-ZScaleFactor new (vla-get-ZScaleFactor source))
            (tc:copy-dyn source new) (tc:set-attributes new (tc:attributes source))
            (tc:copy-xdata source new) (tc:delete source)))))))
(defun tc:copy-xdata (source target / key val)
  (foreach key '("SYSTEM" "VAT LIEU" "TC_SYSTEM" "TC_DN" "TC_WIDTH" "TC_HEIGHT" "TC_ELEVATION" "TC_CABLE")
    (if (setq val (tc:xget source key)) (tc:xset target key val))))
(defun tc:block-rename ( / sample old name def)
  (if (setq sample (tc:pick "\nChon block can doi ten dinh nghia: " '("AcDbBlockReference")))
    (progn (setq old (tc:name sample) name (getstring T "\nTen moi: "))
      (if (or (= name "") (not (snvalid name)) (tc:block-present name)) (tc:fail "Ten moi khong hop le hoac da ton tai."))
      (setq def (vla-item (vla-get-Blocks (tc:doc)) old))
      (if (= (vla-get-IsXRef def) :vlax-true) (tc:fail "Khong doi ten Xref."))
      (vla-put-Name def name) (tc:touch)
      (princ "\nDa doi ten dinh nghia; tat ca tham chieu cung ten duoc cap nhat."))))
(defun tc:block-edit ( / o props p keys i key val old allowed)
  (if (setq o (tc:pick "\nChon dynamic block: " '("AcDbBlockReference")))
    (progn
      (setq props (tc:dynprops o) i 0)
      (foreach p props
        (if (= (vla-get-ReadOnly p) :vlax-false)
          (progn (setq keys (append keys (list (vla-get-PropertyName p))))
            (princ (strcat "\n" (itoa (setq i (1+ i))) ". " (vla-get-PropertyName p)
              " = " (vl-princ-to-string (vlax-variant-value (vla-get-Value p)))
              " | Allowed=" (vl-princ-to-string (tc:variant-list (vla-get-AllowedValues p))))))))
      (if (null keys) (tc:fail "Block khong co dynamic property co the sua."))
      (initget 6) (setq i (getint "\nSo thu tu property (Enter huy): "))
      (if i
        (progn (if (> i (length keys)) (tc:fail "So thu tu khong hop le."))
          (setq key (nth (1- i) keys) old (tc:dyn o key))
          (setq val (if (eq (type old) 'STR) (getstring T "\nGia tri moi (dung chinh xac AllowedValues): ") (getreal "\nGia tri moi: ")))
          (if val (tc:set-dyn (tc:writable o) key val T)))))))
(defun tc:attribute-edit ( / sample pairs pair val objs o tag)
  (if (setq sample (tc:pick "\nBlock mau de lay danh sach tag: " '("AcDbBlockReference")))
    (progn (setq pairs (tc:attributes sample))
      (foreach pair pairs (princ (strcat "\n" (car pair) " = " (cdr pair))))
      (setq tag (strcase (getstring T "\nTag can sua: ")))
      (if (not (assoc tag pairs)) (tc:fail "Tag khong co trong block mau."))
      (setq val (getstring T "\nNoi dung moi (co the rong): ") objs (tc:selection '((0 . "INSERT"))))
      (foreach o objs (tc:set-attributes (tc:writable o) (list (cons tag val)))))))
(defun tc:bounding-box ( / o children child low high p q lo hi pts saved)
  (if (setq o (tc:pick "\nBlock can ve khung trang thai hien thi: " '("AcDbBlockReference")))
    (progn (setq saved *tc-temps* children (tc:explode-temp o 0))
      (foreach child children
        (vla-GetBoundingBox child 'low 'high)
        (setq p (tc:variant-list low) q (tc:variant-list high)
          lo (if lo (mapcar 'min lo p) p) hi (if hi (mapcar 'max hi q) q)))
      (while (not (eq *tc-temps* saved)) (tc:temp-delete (car *tc-temps*)) (setq *tc-temps* (cdr *tc-temps*)))
      (if (null lo) (tc:fail "Block khong co hinh hoc co the ve khung."))
      (setq pts (list (list (car lo) (cadr lo) 0.0) (list (car hi) (cadr lo) 0.0)
        (list (car hi) (cadr hi) 0.0) (list (car lo) (cadr hi) 0.0)))
      (setq o (tc:polyline pts (tc:layer "TC_BOUNDINGBOX" 1))) (vla-put-Closed o :vlax-true))))
(defun tc:bylayer ( / objs o layer color nested seen)
  (setq layer (getstring T "\nLayer dich <TC_STANDARD>: ")) (if (= layer "") (setq layer "TC_STANDARD"))
  (setq color (tc:integer "\nMau layer ACI 1..255" 8))
  (if (> color 255) (tc:fail "ACI chi tu 1 den 255."))
  (tc:layer layer color) (vla-put-Color (vla-item (vla-get-Layers (tc:doc)) layer) color) (tc:touch)
  (setq nested (tc:choose "\nSua ben trong dinh nghia block (anh huong moi tham chieu) [Yes/No]" "Yes No" "No")
    objs (tc:selection nil))
  (foreach o objs (tc:standard-entity (tc:writable o) layer (= nested "Yes")))
  (vla-Regen (tc:doc) 1))
(defun tc:standard-entity (o layer recursive / name def child prop)
  (tc:put-layer o layer) (tc:touch)
  (foreach prop '(TextColor DimensionLineColor ExtensionLineColor)
    (if (vlax-property-available-p o prop T) (vlax-put-property o prop 256)))
  (if (and recursive (= (vla-get-ObjectName o) "AcDbBlockReference"))
    (progn (setq name (vla-get-Name o) def (vla-item (vla-get-Blocks (tc:doc)) name))
      (if (and (not (member name seen)) (= (vla-get-IsXRef def) :vlax-false))
        (progn (setq seen (cons name seen)) (vlax-for child def (tc:standard-entity child "0" T)))))))
(defun tc:insert-aligned ( / sample name pt tangent hit curve close param deriv angle obj)
  (if (setq sample (tc:pick "\nBlock mau: " '("AcDbBlockReference")))
    (progn
      (setq hit (entsel "\nPick LINE/POLYLINE/ARC tai vi tri chen: "))
      (if hit
        (progn (setq curve (car hit) pt (trans (cadr hit) 1 0)
          close (vl-catch-all-apply 'vlax-curve-getClosestPointTo (list curve pt)))
          (if (vl-catch-all-error-p close) (tc:fail "Doi tuong khong phai duong cong ho tro."))
          (tc:xy-check close)
          (setq param (vlax-curve-getParamAtPoint curve close) deriv (vlax-curve-getFirstDeriv curve param)
            angle (atan (cadr deriv) (car deriv)) obj (tc:clone-at sample close))
          (vla-put-Rotation obj angle))))))
(defun tc:line-to-tray ( / lines line segs seg base u n angle tol maxgap minp maxp minx maxx item a b len center groups group found)
  ;; Pair/group only overlapping parallel lines; source entities are retained by default.
  (setq lines (tc:selection '((0 . "LINE"))) maxgap (tc:positive "\nBe rong nhom toi da" 1000.0))
  (foreach line lines
    (setq a (tc:xy-check (tc:variant-list (vla-get-StartPoint line))) b (tc:xy-check (tc:variant-list (vla-get-EndPoint line))))
    (if (> (tc:dist a b) 0.000001) (setq segs (cons (list line a b) segs))))
  (while segs
    (setq base (car segs) segs (cdr segs) a (cadr base) b (caddr base) u (tc:unit (tc:v- b a)) n (tc:perp u)
      group (list base) minx 0.0 maxx (tc:dist a b) minp 0.0 maxp 0.0)
    (foreach seg segs
      (if (and (< (tc:line-angle a b (cadr seg) (caddr seg)) (/ pi 180.0))
               (<= (abs (tc:dot (tc:v- (cadr seg) a) n)) maxgap)
               (> (min maxx (max (tc:dot (tc:v- (cadr seg) a) u) (tc:dot (tc:v- (caddr seg) a) u)))
                  (max minx (min (tc:dot (tc:v- (cadr seg) a) u) (tc:dot (tc:v- (caddr seg) a) u)))))
        (setq group (cons seg group))))
    (foreach seg group (setq segs (tc:remove-one seg segs)))
    (if (> (length group) 1)
      (progn
        (foreach seg group
          (foreach item (list (cadr seg) (caddr seg))
            (setq minp (min minp (tc:dot (tc:v- item a) n)) maxp (max maxp (tc:dot (tc:v- item a) n))
              minx (max minx (min (tc:dot (tc:v- (cadr seg) a) u) (tc:dot (tc:v- (caddr seg) a) u)))
              maxx (min maxx (max (tc:dot (tc:v- (cadr seg) a) u) (tc:dot (tc:v- (caddr seg) a) u))))))
        (if (> (- maxp minp) 0.01)
          (progn (setq center (tc:v+ a (tc:v+ (tc:v* n (/ (+ minp maxp) 2.0)) (tc:v* u minx))))
            (tc:straight center (tc:v+ center (tc:v* u (- maxx minx))) "TRAY" "Cable tray" 0.0 (- maxp minp)
              (tc:cfg 'height) (tc:layer (tc:cfg 'layer) 3))
            (if (= (tc:cfg 'erase) "1") (foreach seg group (tc:delete (tc:writable (car seg)))))))))))
(princ)

;;; ===== tc-electrical =====
;;; Electrical routing between selected insertion points.
(defun tc:electrical-points ( / objs obj base pts start)
  (setq objs (tc:selection '((0 . "INSERT"))))
  (if (< (length objs) 2) (tc:fail "Can it nhat hai block."))
  (setq base (tc:pick "\nChon block dau trong nhom: " '("AcDbBlockReference")))
  (if (null base) (tc:fail "Chua chon block dau."))
  (if (not (vl-some '(lambda (o) (= (vla-get-Handle o) (vla-get-Handle base))) objs))
    (tc:fail "Block dau phai thuoc nhom da chon."))
  (setq start (tc:xy-check (tc:insertion base)))
  (foreach obj objs (setq pts (cons (tc:xy-check (tc:insertion obj)) pts)))
  (list start (tc:remove-one start (reverse pts))))
(defun tc:fillet-poly (o radius)
  (if (> radius 0.0)
    (progn (setvar "FILLETRAD" radius) (setvar "OSMODE" 0)
      (command-s "_.FILLET" "_Polyline" (tc:ename o)) (tc:touch))) o)
(defun tc:electrical (mode / data start pts route o i a b c box props prop options state rotation h)
  (setq data (tc:electrical-points) start (car data) pts (cadr data))
  (if (member mode '("ZIGZAG" "BOX" "ARC"))
    (progn (setq route (tc:row-order (cons start pts) (tc:cfg 'rowtol)))
      (if (> (tc:dist start (car route)) (tc:dist start (last route))) (setq route (reverse route)))
      ;; Rotate a snake to the selected start without dropping any points.
      (while (not (equal (car route) start 0.000001)) (setq route (append (cdr route) (list (car route))))))
    (setq route (tc:nearest-order pts start)))
  (if (= mode "GRID") (setq route (tc:ortho-route route)))
  (setq route (tc:dedup route))
  (if (< (length route) 2) (tc:fail "Cac block trung diem chen."))
  (setq o (tc:polyline route (tc:layer (tc:cfg 'layer) 2)))
  (cond
    ((= mode "ARC")
      (setq h (tc:positive "\nDo vong cung" (tc:cfg 'drop)) i 0)
      (repeat (1- (length route))
        ;; Exact sagitta/chord relation; avoids division by (r-h) singularities.
        (vla-SetBulge o i (/ (* 2.0 h) (tc:dist (nth i route) (nth (1+ i) route)))) (setq i (1+ i))))
    ((= mode "FILLET") (tc:fillet-poly o (tc:cfg 'fillet)))
    ((= mode "BOX")
      (tc:ensure-block "HopchiangD20V1")
      (setq i 0)
      (foreach b route
        (setq a (if (> i 0) (nth (1- i) route)) c (nth (1+ i) route)
          rotation (cond (c (tc:angle b c)) (a (tc:angle a b)) (T 0.0))
          box (tc:insert "HopchiangD20V1" b rotation (tc:cfg 'layer)))
        (vla-put-XScaleFactor box 2.0) (vla-put-YScaleFactor box 2.0) (vla-put-ZScaleFactor box 2.0)
        (setq options nil)
        (foreach prop (tc:dynprops box)
          (if (= (strcase (vla-get-PropertyName prop)) "OPTIONS") (setq options (tc:variant-list (vla-get-AllowedValues prop)))))
        (setq state (if (and a c (> (abs (tc:turn a b c)) 0.1)) 2 1))
        (if (<= (length options) state) (tc:fail "HopchiangD20V1 thieu AllowedValues cua Options."))
        (setq state (nth state options)) (if (eq (type state) 'VARIANT) (setq state (vlax-variant-value state)))
        (tc:set-dyn box "Options" state T) (setq i (1+ i)))))
  (tc:xset o "TC_CABLE" "CABLE") (tc:xset o "SYSTEM" (tc:cfg 'service))
  (princ (strcat "\nDa noi " (itoa (length route)) " diem.")))
(defun tc:offset-links (spine-only / objs obj pts center p guide u axis sorted a b pa pb o)
  (setq objs (tc:selection '((0 . "INSERT"))))
  (if (< (length objs) 2) (tc:fail "Can it nhat hai block."))
  (foreach obj objs (setq pts (cons (tc:xy-check (tc:insertion obj)) pts)))
  (setq center (tc:v* (apply 'mapcar (cons '+ pts)) (/ 1.0 (length pts))))
  (if (setq guide (tc:next-point center "\nDiem tren truc day chinh: "))
    (progn
      (setq u (tc:unit (tc:v- guide center))) (if (null u) (tc:fail "Diem truc trung tam nhom."))
      (setq axis (tc:perp u) sorted (tc:sort pts '(lambda (a b) (< (tc:dot a axis) (tc:dot b axis)))))
      (if spine-only
        (progn
          (foreach p sorted
            (setq pa (tc:v+ guide (tc:v* axis (tc:dot (tc:v- p guide) axis))))
            (if (> (tc:dist p pa) 0.000001) (tc:polyline (list p pa) (tc:layer (tc:cfg 'layer) 2))))
          (setq a (car sorted) b (last sorted))
          (tc:polyline (list (tc:v+ guide (tc:v* axis (tc:dot (tc:v- a guide) axis)))
                            (tc:v+ guide (tc:v* axis (tc:dot (tc:v- b guide) axis)))) (tc:cfg 'layer)))
        (progn
          (setq a (car sorted))
          (foreach b (cdr sorted)
            (setq pa (tc:v+ guide (tc:v* axis (tc:dot (tc:v- a guide) axis)))
                  pb (tc:v+ guide (tc:v* axis (tc:dot (tc:v- b guide) axis)))
                  o (tc:polyline (list a pa pb b) (tc:layer (tc:cfg 'layer) 2)))
            (tc:fillet-poly o (tc:cfg 'fillet)) (tc:xset o "TC_CABLE" "CABLE") (setq a b)))))))
(defun tc:path-between (curve start end / d1 d2 pts point param i result)
  ;; Preserve every original vertex between two projections. Curves must be straight-segment polylines.
  (setq pts (tc:poly-points curve) d1 (vlax-curve-getDistAtPoint curve start) d2 (vlax-curve-getDistAtPoint curve end))
  (if (> d1 d2) (reverse (tc:path-between curve end start))
    (progn
      (setq result (list start))
      (foreach point pts
        (setq param (vlax-curve-getDistAtPoint curve point))
        (if (and (> param (+ d1 0.000001)) (< param (- d2 0.000001))) (setq result (append result (list point)))))
      (tc:dedup (append result (list end))))))
(defun tc:panel-route ( / panel main objs obj root projection p branch path route o)
  (if (and (setq panel (tc:pick "\nBlock tu dien nguon: " '("AcDbBlockReference")))
           (setq main (tc:pick "\nPolyline truc cap chinh (giu nguyen): " '("AcDbPolyline"))))
    (progn
      (tc:poly-points main) (setq root (tc:xy-check (tc:insertion panel))
        projection (vlax-curve-getClosestPointTo main root) objs (tc:selection '((0 . "INSERT"))))
      (foreach obj objs
        (if (/= (vla-get-Handle obj) (vla-get-Handle panel))
          (progn
            (setq p (tc:xy-check (tc:insertion obj)) branch (vlax-curve-getClosestPointTo main p)
              path (tc:path-between main projection branch)
              route (tc:dedup (append (list root (list (car projection) (cadr root) 0.0)) path
                (list (list (car p) (cadr branch) 0.0) p)))
              o (tc:polyline route (tc:layer (tc:cfg 'layer) 2)))
            (tc:xset o "TC_CABLE" (strcat (tc:name panel) " -> " (tc:name obj)))
            (tc:xset o "SYSTEM" (tc:cfg 'service))))))))
(princ)

;;; ===== tc-report =====
;;; Quantity extraction, CAD tables and Excel-compatible CSV.
(defun tc:curve-length (o / value)
  (setq value (vl-catch-all-apply 'vlax-curve-getDistAtParam (list o
    (vl-catch-all-apply 'vlax-curve-getEndParam (list o)))))
  (if (vl-catch-all-error-p value) 0.0 value))
(defun tc:mline-length (o / pts sum)
  (setq pts (tc:chunks (tc:variant-list (vla-get-Coordinates o)) 3) sum 0.0)
  (while (cdr pts) (setq sum (+ sum (tc:dist (car pts) (cadr pts))) pts (cdr pts))) sum)
(defun tc:entity-system (o / val mat name)
  (if (setq val (tc:xget o "TC_SYSTEM")) val
    (progn
      (setq mat (tc:xget o "VAT LIEU"))
      (cond
        ((and mat (wcmatch (strcase mat) "*PPR*,*HDPE*")) "PPR")
        ((and mat (wcmatch (strcase mat) "*UPVC*")) "UPVC")
        ((and mat (wcmatch (strcase mat) "*STK*,*STEEL*")) "STEEL")
        ((= (vla-get-ObjectName o) "AcDbBlockReference")
          (setq name (strcase (tc:name o)))
          (cond ((wcmatch name "* PPR,* HDPE") "PPR") ((wcmatch name "SCREW-*,WELD-*") "STEEL")
            ((wcmatch name "*TRUNKING*,*CABLE TRAY*,*LADDER*") "TRAY")
            ((wcmatch name "ONG GIO*,CO *,CON *,TE *,CHAC *") "DUCT")
            ((wcmatch name "ELB*-D*,TEE-D*,RED-D*,Y-D*") "UPVC") (T "BLOCK")))
        ((tc:xget o "TC_CABLE") "CABLE") (T "UNCLASSIFIED")))))
(defun tc:description (o / typ name atts pair p label)
  (setq typ (vla-get-ObjectName o))
  (cond
    ((= typ "AcDbBlockReference")
      (setq label (tc:name o) atts (acad_strlsort (mapcar '(lambda (pair) (strcat (car pair) "=" (cdr pair))) (tc:attributes o))))
      (foreach name atts (setq label (strcat label " | " name)))
      ;; Include evaluated size and visibility to avoid combining distinct fittings.
      (foreach name '("Width1" "Width2" "Diameter" "Diameter1" "Diameter2" "DN" "Visibility" "Visibility1" "Options")
        (if (setq p (tc:dyn o name)) (setq label (strcat label " | " name "=" (vl-princ-to-string p))))) label)
    ((= typ "AcDbMline") (strcat "ONG MLINE D" (rtos (abs (vla-get-MLineScale o)) 2 3)))
    ((tc:xget o "TC_CABLE") (tc:xget o "TC_CABLE"))
    (T typ)))
(defun tc:straight-block-p (name)
  (member (strcase name) '("TRUNKING" "CABLE TRAY" "LADDER" "ONG GIO NEP TDC" "ONG GIO NEP C"
    "ONG GIO TRON" "ONG GIO TIEU AM NEP TDC" "ONG GIO CACH NHIET NEP TDC" "ONG GIO CACH NHIET NEP C")))
(defun tc:entity-length (o / typ length)
  (setq typ (vla-get-ObjectName o))
  (cond ((= typ "AcDbMline") (tc:mline-length o))
    ((= typ "AcDbBlockReference")
      (if (and (tc:straight-block-p (tc:name o)) (setq length (tc:dyn o "Length")))
        (* length (abs (vla-get-XScaleFactor o))) 0.0))
    (T (tc:curve-length o))))
(defun tc:quantity (filter cable / objs o typ sys desc material service layer key pair row len out)
  (setq objs (tc:selection (if cable '((0 . "LWPOLYLINE,POLYLINE,LINE,ARC")) '((0 . "INSERT,MLINE,LWPOLYLINE,POLYLINE,LINE,ARC")))))
  (foreach o objs
    (setq typ (vla-get-ObjectName o) sys (tc:entity-system o))
    (if (and (not (tc:xget o "TC_ANNOTATION")) (or (null filter) (= sys filter)))
      (progn
        (setq desc (tc:description o) material (tc:xget o "VAT LIEU") service (tc:xget o "SYSTEM") layer (vla-get-Layer o)
          material (if material material "") service (if service service "")
          len (+ (tc:entity-length o) (if cable (tc:cfg 'allowance) 0.0))
          key (list desc material service layer sys) pair (assoc key out))
        (if pair (setq out (subst (list key (1+ (cadr pair)) (+ (caddr pair) len)) pair out))
          (setq out (cons (list key 1 len) out))))))
  (if (null out) (tc:fail "Khong co doi tuong phu hop de thong ke."))
  (setq out (tc:sort out '(lambda (a b) (< (strcase (caar a)) (strcase (caar b))))) row 0)
  (mapcar '(lambda (pair) (setq row (1+ row))
    (list (itoa row) (caar pair) (itoa (cadr pair)) (rtos (/ (caddr pair) (tc:cfg 'unit)) 2 3)
      (cadar pair) (nth 2 (car pair)) (nth 3 (car pair)) (nth 4 (car pair)))) out))
(defun tc:table (title headers rows / point table n r c row value)
  (if (setq point (tc:point "\nDiem dat bang thong ke: "))
    (progn
      (setq n (length headers) table (tc:new (vla-AddTable (tc:space) (tc:3d point) (+ (length rows) 2) n
        (* 2.5 (tc:cfg 'text)) (* 14.0 (tc:cfg 'text)))))
      (vla-put-RegenerateTableSuppressed table :vlax-true)
      (vla-SetTextHeight table 7 (tc:cfg 'text))
      (vla-SetText table 0 0 title) (vla-MergeCells table 0 0 0 (1- n))
      (setq c 0) (foreach value headers (vla-SetText table 1 c value) (setq c (1+ c)))
      (setq r 2)
      (foreach row rows (setq c 0)
        (foreach value row (vla-SetText table r c value) (setq c (1+ c))) (setq r (1+ r)))
      (vla-SetColumnWidth table 0 (* 4.0 (tc:cfg 'text)))
      (vla-SetColumnWidth table 1 (* 55.0 (tc:cfg 'text)))
      (vla-put-RegenerateTableSuppressed table :vlax-false) (vla-Update table) table)))
(defun tc:csv-cell (s / i c out)
  (setq i 1 out "\"")
  ;; Keep spreadsheet formula-like text inert in the exported file.
  (if (and (> (strlen s) 0) (member (substr s 1 1) '("=" "+" "-" "@"))) (setq s (strcat "'" s)))
  (while (<= i (strlen s))
    (setq c (substr s i 1) out (strcat out (if (= c "\"") "\"\"" c)) i (1+ i))) (strcat out "\""))
(defun tc:join (xs separator / out s)
  (if xs (progn (setq out (car xs)) (foreach s (cdr xs) (setq out (strcat out separator s)))))
  (if out out ""))
(defun tc:csv (headers rows / path stream result row)
  (if (setq path (getfiled "Luu CSV (mo bang Excel)" (strcat (getvar "DWGPREFIX") "ToolsCad.csv") "csv" 1))
    (progn
      (setq stream (open path "w" "utf8-bom"))
      (if (null stream) (tc:fail "Khong ghi duoc CSV. Kiem tra quyen ghi va Excel dang mo file."))
      (setq result (vl-catch-all-apply '(lambda ()
        (write-line (tc:join (mapcar 'tc:csv-cell headers) ",") stream)
        (foreach row rows (write-line (tc:join (mapcar 'tc:csv-cell row) ",") stream))) nil))
      (close stream)
      (if (vl-catch-all-error-p result) (tc:fail (strcat "Ghi CSV loi: " (vl-catch-all-error-message result))))
      (princ (strcat "\nDa xuat CSV: " path)))))
(defun tc:statistics (filter cable / rows headers mode)
  (setq rows (tc:quantity filter cable) headers '("STT" "MO TA" "SO LUONG" "TONG DAI (m)" "VAT LIEU" "HE THONG" "LAYER" "NHOM")
    *tc-last-report* (list headers rows)
    mode (tc:choose "\nKet qua [Table/CSV/Both]" "Table CSV Both" "Table"))
  (if (member mode '("Table" "Both")) (tc:table "BANG THONG KE TOOLS CAD" headers rows))
  (if (member mode '("CSV" "Both")) (tc:csv headers rows)))
(defun tc:export-tables ( / objs o rows headers r c row)
  (setq objs (tc:selection '((0 . "ACAD_TABLE"))))
  (foreach o objs
    (setq r 0)
    (repeat (vla-get-Rows o) (setq row nil c 0)
      (repeat (vla-get-Columns o) (setq row (cons (vla-GetText o r c) row) c (1+ c)))
      (setq rows (append rows (list (reverse row))) r (1+ r)))
    (setq rows (append rows (list (list "")))))
  (if rows (tc:csv (car rows) (cdr rows))))
(defun tc:dimension-total ( / objs o rows total value i)
  (setq objs (tc:selection '((0 . "DIMENSION"))) total 0.0 i 0)
  (foreach o objs
    ;; Only linear dimensions have length units; angular/radial dimensions are excluded.
    (if (member (vla-get-ObjectName o) '("AcDbAlignedDimension" "AcDbRotatedDimension"))
      (progn (setq value (vla-get-Measurement o) total (+ total value) i (1+ i))
        (setq rows (cons (list (itoa i) (vla-get-Handle o) (rtos value 2 3) (vla-get-Layer o)) rows)))))
  (if rows
    (tc:table "TONG DIM (DON VI BAN VE)" '("STT" "HANDLE" "CHIEU DAI" "LAYER")
      (append (reverse rows) (list (list "" "TONG" (rtos total 2 3) ""))))
    (tc:fail "Khong co DIM thang de cong.")))
(princ)

;;; ===== tc-annotate =====
;;; Dimensions, notes and XData utilities.
(defun tc:aligned-dim (a b point layer / o)
  (if (> (tc:dist a b) 0.000001)
    (progn (setq o (tc:new (vla-AddDimAligned (tc:space) (tc:3d a) (tc:3d b) (tc:3d point))))
      (tc:put-layer o layer) o)))
(defun tc:dim-blocks ( / objs a b axis points origin location pair mode o first prev)
  (setq objs (tc:selection '((0 . "INSERT"))))
  (if (and (> (length objs) 1) (setq a (tc:point "\nDiem dau truc DIM: "))
    (setq b (tc:next-point a "\nDiem cuoi truc DIM: ")))
    (progn
      (setq axis (tc:unit (tc:v- b a))) (if (null axis) (tc:fail "Truc DIM bang 0."))
      (if (setq location (tc:point "\nVi tri duong DIM: "))
        (progn
          (foreach o objs (setq points (cons (tc:xy-check (tc:insertion o)) points)))
          (setq points (tc:sort points '(lambda (x y) (< (tc:dot x axis) (tc:dot y axis))))
            prev (car points) first prev)
          (foreach pair (cdr points)
            (if (> (abs (tc:dot (tc:v- pair prev) axis)) 0.000001)
              (progn (setq o (tc:new (vla-AddDimRotated (tc:space) (tc:3d prev) (tc:3d pair)
                (tc:3d location) (tc:angle a b)))) (tc:put-layer o (tc:layer "TC_DIM" 7))))
            (setq prev pair))
          (if (= (tc:choose "\nThem DIM tong [Yes/No]" "Yes No" "Yes") "Yes")
            (progn (setq location (tc:v+ location (tc:v* (tc:perp axis) (* 3.0 (tc:cfg 'text))))
              o (tc:new (vla-AddDimRotated (tc:space) (tc:3d first) (tc:3d prev) (tc:3d location) (tc:angle a b))))
              (tc:put-layer o "TC_DIM"))))))))
(defun tc:dim-segments ( / objs o pts a b distance offset location sys)
  (setq distance (tc:positive "\nKhoang cach DIM" 500.0)
    objs (tc:selection '((0 . "LWPOLYLINE,MLINE,INSERT,LINE"))))
  (foreach o objs
    (setq pts
      (cond ((= (vla-get-ObjectName o) "AcDbPolyline") (tc:poly-points o))
        ((= (vla-get-ObjectName o) "AcDbMline") (tc:chunks (tc:variant-list (vla-get-Coordinates o)) 3))
        ((= (vla-get-ObjectName o) "AcDbLine") (list (tc:variant-list (vla-get-StartPoint o)) (tc:variant-list (vla-get-EndPoint o))))
        (T (setq sys (tc:entity-system o))
          (if (not (member sys '("TRAY" "DUCT"))) (tc:fail "Chi DIM block thang mang/ong gio."))
          (setq sys (tc:segment o sys)) (list (tc:s sys 'a) (tc:s sys 'b)))))
    (while (cdr pts)
      (setq a (tc:xy-check (car pts)) b (tc:xy-check (cadr pts))
        location (tc:polar (tc:v* (tc:v+ a b) 0.5) (+ (tc:angle a b) (/ pi 2.0)) distance))
      (tc:aligned-dim a b location (tc:layer "TC_DIM" 7)) (setq pts (cdr pts)))))
(defun tc:curve-text ( / o text height offset curve middle param tangent angle point obj)
  (if (setq o (tc:pick "\nChon duong cong de dat text: " nil))
    (progn (setq curve (tc:ename o) middle (/ (tc:curve-length o) 2.0))
      (if (<= middle 0.0) (tc:fail "Doi tuong khong co chieu dai duong cong."))
      (setq text (getstring T "\nNoi dung text: ") height (tc:positive "\nChieu cao chu" (tc:cfg 'text))
        offset (tc:positive "\nKhoang cach text toi tuyen" (* height 1.5))
        point (tc:xy-check (vlax-curve-getPointAtDist curve middle)) param (vlax-curve-getParamAtPoint curve point)
        tangent (vlax-curve-getFirstDeriv curve param) angle (atan (cadr tangent) (car tangent)))
      (setq point (tc:polar point (+ angle (/ pi 2.0)) offset))
      (if (or (> angle (/ pi 2.0)) (< angle (- (/ pi 2.0)))) (setq angle (+ angle pi)))
      (setq obj (tc:new (vla-AddText (tc:space) text (tc:3d point) height)))
      (vla-put-Rotation obj angle) (tc:put-layer obj (tc:layer (tc:cfg 'layer) 7)))))
(defun tc:leader ( / a b text obj)
  (if (and (setq a (tc:point "\nDau mui ten: ")) (setq b (tc:next-point a "\nVi tri ghi chu: ")))
    (progn (setq text (getstring T "\nNoi dung ghi chu: ")
      obj (tc:new (vla-AddMLeader (tc:space) (tc:array (append a b) vlax-vbDouble) 0)))
      (vla-put-ContentType obj 2) (vla-put-TextString obj text)
      (vla-put-TextHeight obj (tc:cfg 'text)) (tc:put-layer obj (tc:layer (tc:cfg 'layer) 7)))))
(defun tc:xdata-edit (write / objs obj key value)
  (setq key (getstring T "\nTen nhom XData <SYSTEM>: ")) (if (= key "") (setq key "SYSTEM"))
  (if (not (snvalid key)) (tc:fail "Ten XData khong hop le."))
  (if write (setq value (getstring T "\nNoi dung: ")))
  (setq objs (tc:selection nil))
  (foreach obj objs
    (if write (tc:xset (tc:writable obj) key value)
      (princ (strcat "\n" (vla-get-Handle obj) " | " key " = " (if (tc:xget obj key) (tc:xget obj key) "<chua gan>"))))))
(defun tc:iso ( / objs base angle block source array ref exploded obj)
  (setq objs (tc:selection nil))
  (if (and objs (setq base (tc:point "\nDiem goc 2.5D (giu ban goc): ")))
    (progn
      (setq angle (tc:choose "\nGoc [A30/A45]" "A30 A45" "A30")
        block (tc:new (vla-Add (vla-get-Blocks (tc:doc)) (tc:3d base) "*U")))
      (vla-CopyObjects (tc:doc) (tc:array objs vlax-vbObject) block)
      ;; Match test.bas's nonuniform block scaling, retaining original entities.
      (setq ref (tc:new (vla-InsertBlock (tc:space) (tc:3d base) (vla-get-Name block) 1.0 0.577350269 1.0
        (* pi (/ (if (= angle "A45") 45.0 30.0) 180.0)))))
      (setq exploded (vlax-invoke ref 'Explode))
      (foreach obj exploded (tc:new obj)) (tc:delete ref)
      (princ "\nDa tao ban sao 2.5D theo quy tac VBA, ban goc duoc giu nguyen."))))
(defun tc:flow-arrow ( / picked obj point closest param tangent pts a b projection best size direction arrow layer)
  (if (setq picked (entsel "\nChon tuyen tai vi tri dat huong chay: "))
    (progn
      (setq obj (tc:writable (tc:obj (car picked))) point (tc:xy-check (trans (cadr picked) 1 0)))
      (cond
        ((= (vla-get-ObjectName obj) "AcDbMline")
          (setq pts (tc:chunks (tc:variant-list (vla-get-Coordinates obj)) 3))
          (while (cdr pts)
            (setq a (car pts) b (cadr pts) projection (tc:project point a b T))
            (if (or (null best) (< (tc:dist point projection) best))
              (setq best (tc:dist point projection) closest projection tangent (tc:v- b a)))
            (setq pts (cdr pts))))
        ((= (vla-get-ObjectName obj) "AcDbBlockReference")
          (setq a (tc:insertion obj) b (tc:polar a (vla-get-Rotation obj) (if (tc:dyn obj "Length") (tc:dyn obj "Length") 0.0)))
          (if (<= (tc:dist a b) 0.000001) (tc:fail "Chon block tuyen thang co Length."))
          (setq closest (tc:project point a b T) tangent (tc:v- b a)))
        (T
          (setq closest (vl-catch-all-apply 'vlax-curve-getClosestPointTo (list obj point)))
          (if (vl-catch-all-error-p closest) (tc:fail "Doi tuong khong phai tuyen ho tro."))
          (setq param (vlax-curve-getParamAtPoint obj closest) tangent (vlax-curve-getFirstDeriv obj param))))
      (tc:xy-check closest)
      (if (> (abs (caddr tangent)) 0.000001) (tc:fail "Huong chay chi ho tro WCS XY."))
      (setq size (tc:positive "\nChieu dai mui ten" (tc:cfg 'text))
        direction (tc:choose "\nChieu [Along/Reverse]" "Along Reverse" "Along")
        layer (tc:layer (vla-get-Layer obj) 3)
        arrow (tc:polyline (tc:arrow-points closest (+ (atan (cadr tangent) (car tangent)) (if (= direction "Reverse") pi 0.0)) size) layer))
      (vla-put-ConstantWidth arrow (max 0.5 (* 0.04 size)))
      (tc:xset arrow "TC_ANNOTATION" "1") (tc:xset obj "TC_FLOW" (if (= direction "Reverse") "REVERSE" "FORWARD")))))
(princ)

;;; ===== tc-drain =====
;;; Planar drainage: chamfer vertices and attach branch endpoints to a main route.
(defun tc:chamfer-points (pts amount / out i a b c pre post d)
  (if (< (length pts) 3) pts
    (progn
      (setq i 1 out (list (car pts)))
      (while (< i (1- (length pts)))
        (setq a (nth (1- i) pts) b (nth i pts) c (nth (1+ i) pts))
        (if (equal (tc:corner a b c) 90)
          (progn (setq d (min amount (* 0.4 (tc:dist a b)) (* 0.4 (tc:dist b c)))
            pre (tc:polar b (tc:angle b a) d) post (tc:polar b (tc:angle b c) d)
            out (append out (list pre post))))
          (setq out (append out (list b))))
        (setq i (1+ i))) (append out (list (last pts))))))
(defun tc:chamfer ( / objs o pts new amount)
  (setq amount (tc:positive "\nKhoang vat goc 45" 100.0) objs (tc:selection '((0 . "LWPOLYLINE"))))
  (foreach o objs
    (setq pts (tc:poly-points o) new (tc:new (vla-Copy (tc:writable o))))
    (vla-put-Coordinates new (tc:array (apply 'append (mapcar '(lambda (p) (list (car p) (cadr p)))
      (tc:chamfer-points pts amount))) vlax-vbDouble))
    (if (= (tc:cfg 'erase) "1") (tc:delete o))))
(defun tc:insert-node (pts node / out a b found)
  (setq a (car pts) out (list a))
  (foreach b (cdr pts)
    (if (and (not found) (tc:on-segment node a b 0.01))
      (progn (if (and (> (tc:dist node a) 0.000001) (> (tc:dist node b) 0.000001))
        (setq out (append out (list node)))) (setq found T)))
    (setq out (append out (list b)) a b)) out)
(defun tc:drain-connect ( / main root rootproj rootdist branches o pts mainpts a b pa pb near far cp distmain targetdist join branchcut distance len new nodes)
  (if (and (setq main (tc:pick "\nChon polyline ong thoat chinh: " '("AcDbPolyline")))
           (setq root (tc:point "\nDiem huong ve ong dung/xa cuoi tuyen: ")))
    (progn
      (setq mainpts (tc:poly-points main) rootproj (vlax-curve-getClosestPointTo main root)
        rootdist (vlax-curve-getDistAtPoint main rootproj) len (tc:curve-length main)
        distance (tc:positive "\nKhoang vat nhanh 45 do" 100.0) branches (tc:selection '((0 . "LWPOLYLINE"))))
      (foreach o branches
        (if (/= (vla-get-Handle o) (vla-get-Handle main))
          (progn
            (setq pts (tc:poly-points o) a (car pts) b (last pts)
              pa (vlax-curve-getClosestPointTo main a) pb (vlax-curve-getClosestPointTo main b))
            (if (< (tc:dist a pa) (tc:dist b pb))
              (setq pts (reverse pts) near a cp pa) (setq near b cp pb))
            (if (> (tc:dist near cp) (tc:cfg 'gap)) (tc:fail "Dau nhanh cach ong chinh qua sai so noi."))
            (setq far (nth (- (length pts) 2) pts) distmain (vlax-curve-getDistAtPoint main cp)
              targetdist (max 0.0 (min len (+ distmain (if (> rootdist distmain) distance (- distance)))))
              join (vlax-curve-getPointAtDist main targetdist)
              branchcut (tc:polar cp (tc:angle cp far) (min distance (* 0.4 (tc:dist cp far)))))
            (if (not (equal (abs (tc:dot (tc:unit (tc:v- far cp)) (tc:unit (tc:v- join cp)))) 0.0 0.001))
              (tc:fail "Nhanh phai vuong goc doan chinh va cach dinh chinh it nhat khoang vat."))
            ;; Equal legs give a genuine 45-degree diagonal.
            (setq branchcut (tc:polar cp (tc:angle cp far) (tc:dist cp join))
              new (tc:new (vla-Copy (tc:writable o))))
            (if (>= (tc:dist cp join) (* 0.8 (tc:dist cp far))) (tc:fail "Doan nhanh qua ngan de vat goc."))
            (setq pts (append (reverse (cdr (reverse pts))) (list branchcut join)))
            (vla-put-Coordinates new (tc:array (apply 'append (mapcar '(lambda (p) (list (car p) (cadr p)))
              (tc:dedup pts))) vlax-vbDouble))
            (setq nodes (cons join nodes))
            (if (= (tc:cfg 'erase) "1") (tc:delete o)))))
      (if nodes
        (progn
          (setq new (tc:new (vla-Copy (tc:writable main))))
          (foreach join nodes (setq mainpts (tc:insert-node mainpts join)))
          (vla-put-Coordinates new (tc:array (apply 'append (mapcar '(lambda (p) (list (car p) (cadr p))) mainpts)) vlax-vbDouble))
          (if (= (tc:cfg 'erase) "1") (tc:delete main)))))))
(princ)

;;; ===== tc-ui =====
;;; DCL is embedded in the release LSP and written to a unique temporary file.
(setq *tc-systems* '("PPR" "UPVC" "STEEL" "TRAY" "DUCT"))
(setq *tc-groups* '("Ve ong / mang / duct" "Noi phu kien" "Block / thu vien" "Dien / day cap" "DIM / ghi chu" "Thong ke / CSV" "Tien ich / kiem tra"))
(defun tc:materials (sys)
  (cond ((= sys "PPR") '("PPR")) ((= sys "UPVC") '("UPVC")) ((= sys "STEEL") '("STK"))
    ((= sys "TRAY") '("Cable tray" "Trunking" "Ladder"))
    (T '("nep TDC" "nep C" "tron" "tieu am nep TDC" "cach nhiet nep TDC" "cach nhiet nep C"))))
(defun tc:list-tile (key values)
  (start_list key) (mapcar 'add_list values) (end_list))
(defun tc:ui-system (value / sys index)
  (setq sys (nth (atoi value) *tc-systems*) *tc-ui-materials* (tc:materials sys)
    index (vl-position (tc:cfg 'material) *tc-ui-materials*))
  (tc:list-tile "material" *tc-ui-materials*) (set_tile "material" (itoa (if index index 0)))
  (if (member (get_tile "layer") '("TC_PPR" "TC_UPVC" "TC_STEEL" "TC_TRAY" "TC_DUCT"))
    (set_tile "layer" (strcat "TC_" sys)))
  (if (and (tc:pipe-p sys) (not (member (atoi (get_tile "dn")) (tc:dn-values sys))))
    (set_tile "dn" (if (= sys "UPVC") "60" "25"))))
(defun tc:ui-group (value / item)
  (setq *tc-ui-group* (atoi value) *tc-ui-items* nil)
  (foreach item *tc-commands*
    (if (= (car item) *tc-ui-group*) (setq *tc-ui-items* (append *tc-ui-items* (list item)))))
  (tc:list-tile "commands" (mapcar '(lambda (item) (strcat "[" (cadr item) "] " (caddr item))) *tc-ui-items*))
  (set_tile "commands" "0") (tc:ui-hint))
(defun tc:ui-hint ( / item)
  (setq item (nth (atoi (get_tile "commands")) *tc-ui-items*))
  (if item (set_tile "hint" (nth 3 item))))
(defun tc:ui-save ( / pair key value parsed values problem sys mat)
  (foreach key '(dn width height text gap overlap fillet rowtol allowance unit)
    (setq value (distof (get_tile (strcase (vl-symbol-name key) T)) 2))
    (if (or (null value) (< value 0.0) (and (not (member key '(allowance overlap fillet))) (equal value 0.0 0.000000001)))
      (setq problem (strcat "Gia tri khong hop le: " (vl-symbol-name key)))
      (setq values (cons (cons key value) values))))
  (if (or (= (get_tile "layer") "") (not (snvalid (get_tile "layer")))) (setq problem "Ten layer khong hop le."))
  (if problem (progn (set_tile "error" problem) nil)
    (progn
      (foreach pair values (tc:set (car pair) (cdr pair)))
      (foreach key '(layer service elevation erase note) (tc:set key (get_tile (strcase (vl-symbol-name key) T))))
      (setq sys (nth (atoi (get_tile "system")) *tc-systems*) mat (nth (atoi (get_tile "material")) *tc-ui-materials*))
      (tc:set 'system sys) (tc:set 'material mat) (tc:save-config) (set_tile "error" "Da luu thong so.") T)))
(defun tc:ui-run ()
  (if (tc:ui-save)
    (progn (setq *tc-ui-command* (cadr (nth (atoi (get_tile "commands")) *tc-ui-items*))) (done_dialog 1))))
(defun tc:dcl-file ( / file stream line)
  (setq file (vl-filename-mktemp "ToolsCad-" nil ".dcl") stream (open file "w"))
  (if (null stream) (tc:fail "Khong tao duoc DCL tam. Kiem tra thu muc TEMP."))
  (foreach line *tc-dcl-lines* (write-line line stream)) (close stream) file)
(defun tc:panel ( / *error* path dialog result key index)
  (defun *error* (msg)
    (if (and dialog (>= dialog 0)) (unload_dialog dialog))
    (if path (vl-file-delete path)) (princ (strcat "\nTOOLS CAD: " msg)) (princ))
  (if (not (boundp '*tc-ui-group*)) (setq *tc-ui-group* 0))
  (setq path (tc:dcl-file) dialog (load_dialog path) result 1)
  (if (< dialog 0) (tc:fail "Khong nap duoc giao dien DCL."))
  (while (= result 1)
    (if (not (new_dialog "tc_main" dialog)) (tc:fail "Khong tao duoc bang dieu khien."))
    (tc:list-tile "groups" *tc-groups*) (set_tile "groups" (itoa *tc-ui-group*))
    (tc:list-tile "system" *tc-systems*)
    (setq index (vl-position (tc:cfg 'system) *tc-systems*)) (if (null index) (setq index 0))
    (set_tile "system" (itoa index)) (tc:ui-system (itoa index))
    (foreach key '(dn width height text gap overlap fillet rowtol allowance unit)
      (set_tile (strcase (vl-symbol-name key) T) (rtos (tc:cfg key) 2 3)))
    (foreach key '(layer service elevation erase note) (set_tile (strcase (vl-symbol-name key) T) (tc:cfg key)))
    (tc:ui-group (itoa *tc-ui-group*))
    (action_tile "groups" "(tc:ui-group $value)")
    (action_tile "system" "(tc:ui-system $value)")
    (action_tile "commands" "(if (= $reason 4) (tc:ui-run) (tc:ui-hint))")
    (action_tile "run" "(tc:ui-run)") (action_tile "save" "(tc:ui-save)")
    (action_tile "help" "(tc:help)") (action_tile "cancel" "(done_dialog 0)")
    (setq result (start_dialog))
    (if (= result 1) (apply (read (strcat "C:" *tc-ui-command*)) nil)))
  (unload_dialog dialog) (vl-file-delete path) (princ))
(defun tc:browser-filter ( / pattern name)
  (setq pattern (strcase (get_tile "query")) *tc-browser-shown* nil)
  (if (= pattern "") (setq pattern "*"))
  (if (not (wcmatch pattern "*`**,*`?*")) (setq pattern (strcat "*" pattern "*")))
  (foreach name *tc-browser-all*
    (if (wcmatch (strcase name) pattern) (setq *tc-browser-shown* (cons name *tc-browser-shown*))))
  (setq *tc-browser-shown* (reverse *tc-browser-shown*))
  (tc:list-tile "blocks" *tc-browser-shown*) (set_tile "blocks" "0")
  (set_tile "count" (strcat (itoa (length *tc-browser-shown*)) " block phu hop.")))
(defun tc:browser-accept ()
  (if *tc-browser-shown*
    (progn (setq *tc-browser-name* (nth (atoi (get_tile "blocks")) *tc-browser-shown*)) (done_dialog 1))
    (set_tile "error" "Khong co block phu hop.")))
(defun tc:browser ( / path dialog result name names)
  (setq names (append (tc:block-names (tc:dbx)) (tc:block-names (tc:doc))) *tc-browser-all* nil *tc-browser-name* nil)
  (foreach name (acad_strlsort names) (if (not (member name *tc-browser-all*)) (setq *tc-browser-all* (cons name *tc-browser-all*))))
  (setq *tc-browser-all* (reverse *tc-browser-all*) path (tc:dcl-file) dialog (load_dialog path))
  (if (and (>= dialog 0) (new_dialog "tc_blocks" dialog))
    (progn (set_tile "query" "*") (tc:browser-filter)
      (action_tile "filter" "(tc:browser-filter)") (action_tile "query" "(tc:browser-filter)")
      (action_tile "blocks" "(if (= $reason 4) (tc:browser-accept))")
      (action_tile "accept" "(tc:browser-accept)") (action_tile "cancel" "(done_dialog 0)")
      (setq result (start_dialog))))
  (if (>= dialog 0) (unload_dialog dialog)) (vl-file-delete path)
  (if (= result 1) *tc-browser-name*))
(defun tc:insert-browser ( / name point angle o scale)
  (if (setq name (tc:browser))
    (progn
      (setq scale (tc:positive "\nTy le chen" (tc:cfg 'scale)))
      (while (setq point (tc:point "\nDiem chen (Enter ket thuc): "))
        (setq angle (getangle (trans point 0 1) "\nHuong block <0>: "))
